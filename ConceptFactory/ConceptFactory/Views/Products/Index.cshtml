@model IEnumerable<ConceptFactory.Models.Product>
@{
    ViewData["Title"] = "Products";
    ViewData["ActivePage"] = "Products";
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    int pageSize = 12;
    int startItem = totalCount == 0 ? 0 : ((page - 1) * pageSize) + 1;
    int endItem = Math.Min(page * pageSize, totalCount);
}

<div class="page-container">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">Products</h1>
            <p class="page-subtitle">Manage your store products, edit details and organize</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus fa-lg"></i> Add Product
        </a>
    </div>
    <!-- Filters -->
    <div class="filter-bar">
        <form method="get" asp-action="Index" class="filter-form">
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" name="search" value="@ViewBag.Search"
                       placeholder="Search Products..." class="search-input" />
            </div>
            <select name="categoryId" asp-items="ViewBag.Categories" class="filter-select">
                <option value="">All Categories</option>
            </select>
            <select name="status" class="filter-select">
                <option value="" selected="@(ViewBag.Status == null)">All Status</option>
                <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
                <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive</option>
            </select>
            <button type="submit" class="btn btn-outline">
                <i class="fa-solid fa-filter"></i> Filter
            </button>
        </form>
    </div>

    <!-- Product Table -->
    <div class="card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Products</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="empty-state">
                            <i class="fa-solid fa-box-open"></i>
                            <p>No products found.</p>
                            <a asp-action="Create" class="btn btn-primary btn-sm">Add Your First Product</a>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var product in Model)
                    {
                        string catName = product.Category?.CategoryName?.ToLower() ?? "";
                        string mockupSvg = "/images/mockups/tshirt.svg";
                        int px = 148, py = 130, pw = 104, ph = 110;

                        if (catName.Contains("hoodie")) {
                            mockupSvg = "/images/mockups/hoodie.svg"; px=152; py=148; pw=96; ph=100;
                        } else if (catName.Contains("polo")) {
                            mockupSvg = "/images/mockups/polo.svg"; px=152; py=195; pw=96; ph=100;
                        } else if (catName.Contains("tote") || catName.Contains("bag")) {
                            mockupSvg = "/images/mockups/totebag.svg"; px=148; py=165; pw=104; ph=130;
                        }

                        string designSrc = string.IsNullOrEmpty(product.ImagePath) ? "" : product.ImagePath;

                        <tr>
                            <td>
                                <div class="product-cell">
                                    <!-- Mockup thumbnail canvas -->
                                    <div class="product-thumb product-thumb-canvas">
                                        <canvas class="thumb-canvas"
                                                width="80" height="88"
                                                data-garment="@mockupSvg"
                                                data-design="@designSrc"
                                                data-px="@px" data-py="@py"
                                                data-pw="@pw" data-ph="@ph">
                                        </canvas>
                                    </div>
                                    <span class="product-name">@product.ProductName</span>
                                </div>
                            </td>
                            <td>@product.Category?.CategoryName</td>
                            <td class="price-cell">₱@product.Price.ToString("N2")</td>
                            <td>@product.StockQuantity</td>
                            <td>
                                <span class="status-badge @(product.Status == "Active" ? "status-active" : "status-inactive")">
                                    @product.Status
                                </span>
                            </td>
                            <td>
                                <div class="action-btns">
                                    <a asp-action="Edit" asp-route-id="@product.ProductID"
                                       class="btn-icon btn-edit" title="Edit">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <button type="button" class="btn-icon btn-delete" title="Delete"
                                            onclick="confirmDelete(@product.ProductID, '@Html.Raw(product.ProductName.Replace("'","\\'"))')">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="pagination">
                <span class="page-info">Showing @startItem–@endItem of @totalCount products</span>
                <div class="page-btns">
                    @if (page > 1)
                    {
                        <a asp-action="Index" asp-route-page="@(page-1)"
                           asp-route-search="@ViewBag.Search" asp-route-categoryId="@ViewBag.CategoryId"
                           asp-route-status="@ViewBag.Status" class="page-btn">‹</a>
                    }
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <a asp-action="Index" asp-route-page="@i"
                           asp-route-search="@ViewBag.Search" asp-route-categoryId="@ViewBag.CategoryId"
                           asp-route-status="@ViewBag.Status"
                           class="page-btn @(i == page ? "active" : "")">@i</a>
                    }
                    @if (page < totalPages)
                    {
                        <a asp-action="Index" asp-route-page="@(page+1)"
                           asp-route-search="@ViewBag.Search" asp-route-categoryId="@ViewBag.CategoryId"
                           asp-route-status="@ViewBag.Status" class="page-btn">›</a>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="pagination">
                <span class="page-info">Showing @startItem–@endItem of @totalCount products</span>
            </div>
        }
    </div>
</div>

<!-- Delete Modal -->
<div id="deleteModal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
        <div class="modal-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <h3 class="modal-title">Delete Product?</h3>
        <p class="modal-body">Are you sure you want to delete <strong id="deleteProductName"></strong>? This action cannot be undone.</p>
        <div class="modal-actions">
            <button onclick="closeModal()" class="btn btn-outline">Cancel</button>
            <form id="deleteForm" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
// ── Render all thumbnail mockup canvases ────────────────────
document.addEventListener('DOMContentLoaded', function () {

    document.querySelectorAll('.thumb-canvas').forEach(function (canvas) {
        const garmentSrc = canvas.dataset.garment;
        const designSrc  = canvas.dataset.design;
        // Print area coords are for the FULL 400x440 canvas — scale down to 80x88
        const fullW = 400, fullH = 440;
        const scaleX = canvas.width  / fullW;
        const scaleY = canvas.height / fullH;

        const px = parseFloat(canvas.dataset.px) * scaleX;
        const py = parseFloat(canvas.dataset.py) * scaleY;
        const pw = parseFloat(canvas.dataset.pw) * scaleX;
        const ph = parseFloat(canvas.dataset.ph) * scaleY;

        const ctx = canvas.getContext('2d');

        // Draw garment first
        const garment = new Image();
        garment.onload = function () {
            ctx.drawImage(garment, 0, 0, canvas.width, canvas.height);

            if (designSrc) {
                // Draw design on top within print area
                const design = new Image();
                design.crossOrigin = 'anonymous';
                design.onload = function () {
                    ctx.save();
                    ctx.beginPath();
                    ctx.rect(px, py, pw, ph);
                    ctx.clip();
                    ctx.globalAlpha = 0.92;
                    ctx.drawImage(design, px, py, pw, ph);
                    ctx.globalAlpha = 1.0;
                    ctx.restore();
                    // Subtle print blend
                    ctx.globalAlpha = 0.07;
                    ctx.fillStyle = '#000';
                    ctx.fillRect(px, py, pw, ph);
                    ctx.globalAlpha = 1.0;
                };
                design.onerror = function () { /* no design, just show garment */ };
                design.src = designSrc;
            }
        };
        garment.src = garmentSrc;
    });

});

// ── Modal ───────────────────────────────────────────────────
function confirmDelete(id, name) {
    document.getElementById('deleteProductName').textContent = name;
    document.getElementById('deleteForm').action = '/Products/Delete/' + id;
    document.getElementById('deleteModal').style.display = 'flex';
}
function closeModal() { 
    document.getElementById('deleteModal').style.display = 'none';
}
document.getElementById('selectAll').addEventListener('change', function () {
    document.querySelectorAll('.row-check').forEach(cb => cb.checked = this.checked);
});
</script>
}
