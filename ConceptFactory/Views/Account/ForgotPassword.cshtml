@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password — ConceptFactory</title>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <!-- auth.css used on this page: .blob-1, .blob, .blob-2, .blob-3, .dot-grid, .auth-card, .auth-icon, .auth-title, .auth-sub, .auth-error-box, .form-group, .form-label, .input-wrap, .prefix, .btn-primary, .auth-footer -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
    <div class="dot-grid"></div>

    <div class="auth-card">
        <div class="auth-icon">🔑</div>
        <h1 class="auth-title">Forgot Password?</h1>
        <p class="auth-sub">Enter your email and we'll send a reset code to it</p>

        <form method="post" asp-controller="Account" asp-action="ForgotPassword">
            @Html.AntiForgeryToken()

            @if (TempData["Error"] != null)
            {
                <div class="auth-error-box">
                    <i class="fa-solid fa-circle-xmark"></i> @TempData["Error"]
                </div>
            }

            <div class="form-group">
                <label class="form-label">Email</label>
                <div class="input-wrap">
                    <i class="fa-regular fa-envelope prefix"></i>
                    <input type="email" name="Email" placeholder="Enter your account email" autocomplete="email" required />
                </div>
            </div>

            <button type="submit" class="btn-primary">Send Reset Code</button>
        </form>

        <p class="auth-footer">
            Remembered it? <a asp-controller="Account" asp-action="Login">Back to Login</a>
        </p>
    </div>

    <script src="~/js/auth.js" asp-append-version="true"></script>
</body>
</html>
