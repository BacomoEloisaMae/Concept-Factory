@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
    string? email = ViewBag.Email;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password — ConceptFactory</title>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <!-- auth.css used on this page: .blob-1, .blob, .blob-2, .blob-3, .dot-grid, .auth-card, .auth-icon, .auth-title, .auth-sub, .auth-hint-box, .auth-error-box, .auth-success-box, .form-group, .form-label, .input-wrap, .prefix, .toggle-pw, .pw-requirements, .btn-primary, .auth-footer -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
    <div class="dot-grid"></div>

    <div class="auth-card">
        <div class="auth-icon">✉️</div>
        <h1 class="auth-title">Enter Reset Code</h1>
        <p class="auth-sub">Check your email for the 6-digit code we sent</p>

        @if (TempData["DevResetCode"] != null)
        {
            <div class="auth-hint-box">
                <i class="fa-solid fa-flask"></i> Dev mode (Gmail not configured yet) — your code is
                <strong>@TempData["DevResetCode"]</strong>
            </div>
        }

        <form method="post" asp-controller="Account" asp-action="ResetPassword">
            @Html.AntiForgeryToken()

            @if (TempData["Error"] != null)
            {
                <div class="auth-error-box">
                    <i class="fa-solid fa-circle-xmark"></i> @TempData["Error"]
                </div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="auth-success-box">
                    <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
                </div>
            }

            <div class="form-group">
                <label class="form-label">Email</label>
                <div class="input-wrap">
                    <i class="fa-regular fa-envelope prefix"></i>
                    <input type="email" name="Email" value="@email" placeholder="Enter your account email" autocomplete="email" required />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Reset Code</label>
                <div class="input-wrap">
                    <i class="fa-solid fa-key prefix"></i>
                    <input type="text" name="Code" maxlength="6" placeholder="6-digit code" inputmode="numeric" required />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">New Password</label>
                <div class="input-wrap">
                    <i class="fa-solid fa-lock prefix"></i>
                    <input type="password" name="NewPassword" id="pwReg" placeholder="At least 8 characters"
                           autocomplete="new-password" oninput="checkStrength(this.value)" />
                    <button type="button" class="toggle-pw" onclick="togglePw('pwReg', this)">
                        <i class="fa-regular fa-eye"></i>
                    </button>
                </div>
                <div class="pw-strength" id="pwStrength">
                    <span></span><span></span><span></span>
                </div>
                <ul class="pw-requirements" id="pwRequirements">
                    <li id="pwReqLength"><i class="fa-regular fa-circle"></i> At least 8 characters</li>
                    <li id="pwReqUpper"><i class="fa-regular fa-circle"></i> One uppercase letter (A-Z)</li>
                    <li id="pwReqLower"><i class="fa-regular fa-circle"></i> One lowercase letter (a-z)</li>
                    <li id="pwReqNumber"><i class="fa-regular fa-circle"></i> One number (0-9)</li>
                    <li id="pwReqNoSpecial"><i class="fa-regular fa-circle"></i> No special characters</li>
                </ul>
            </div>

            <div class="form-group">
                <label class="form-label">Confirm New Password</label>
                <div class="input-wrap">
                    <i class="fa-solid fa-lock prefix"></i>
                    <input type="password" name="ConfirmPassword" id="pwConfirm" placeholder="Re-enter new password" autocomplete="new-password" />
                    <button type="button" class="toggle-pw" onclick="togglePw('pwConfirm', this)">
                        <i class="fa-regular fa-eye"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn-primary">Reset Password</button>
        </form>

        <p class="auth-footer">
            <a asp-controller="Account" asp-action="ForgotPassword">Resend code</a> ·
            <a asp-controller="Account" asp-action="Login">Back to Login</a>
        </p>
    </div>

    <script src="~/js/auth.js" asp-append-version="true"></script>
</body>
</html>
