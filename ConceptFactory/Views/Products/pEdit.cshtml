@model ConceptFactory.Models.Product
@{
    ViewData["Title"] = "Edit Product";
    ViewData["ActivePage"] = "Products";
    string existingImage = Model.ImagePath ?? "";
}

<div class="page-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">Edit Product</h1>
            <p class="page-subtitle">Update the product details below.</p>
        </div>
        <a asp-action="pIndex" class="btn btn-outline">
            <i class="fa-solid fa-arrow-left"></i> Back to Products
        </a>
    </div>

    <div class="form-card">
        <form asp-action="pEdit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProductID" />
            <input type="hidden" asp-for="DateAdded" />
            <input type="hidden" asp-for="ImagePath" />

            <div class="form-grid">
                <div class="form-col">
                    <div class="form-col left">
                        <div class="form-header">
                            <h2>Basic Information</h2>
                        </div>

                        <div class="form-group">
                            <label asp-for="ProductName" class="form-label"></label>
                            <input asp-for="ProductName" class="form-control" placeholder="e.g. Basic Cotton T-Shirt" />
                            <span asp-validation-for="ProductName" class="field-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="CategoryID" class="form-label">Category</label>
                            <select asp-for="CategoryID" asp-items="ViewBag.CategoryID" id="categorySelect" class="form-control">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryID" class="field-error"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Size</label>
                            <div class="size-dropdown" id="sizeDropdown">
                                <button type="button" class="size-dropdown-trigger" id="sizeTrigger" onclick="toggleSizeDropdown()">
                                    <span id="sizeTriggerText">Select Size</span>
                                    <i class="fa-solid fa-chevron-down size-chevron" id="sizeChevron"></i>
                                </button>
                                <div class="size-dropdown-panel" id="sizePanel">
                                    <div class="size-list" id="sizeList">
                                        <div class="size-list-item" data-size="XS">XS</div>
                                        <div class="size-list-item" data-size="S">S</div>
                                        <div class="size-list-item" data-size="M">M</div>
                                        <div class="size-list-item" data-size="L">L</div>
                                        <div class="size-list-item" data-size="XL">XL</div>
                                        <div class="size-list-item" data-size="XXL">XXL</div>
                                        <div class="size-list-item" data-size="One Size">One Size</div>
                                    </div>
                                </div>
                            </div>
                            <input type="hidden" id="sizeHidden" name="Size" value="@Model.Size" />
                            <span asp-validation-for="Size" class="field-error"></span>
                        </div>

                        <div class="form-row-2">
                            <div class="form-group">
                                <label asp-for="Price" class="form-label"></label>
                                <div class="input-prefix">
                                    <span class="prefix-text">₱</span>
                                    <input asp-for="Price" type="number" step="0.01" min="0" class="form-control prefix-input" placeholder="Enter price" />
                                </div>
                                <span asp-validation-for="Price" class="field-error"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="StockQuantity" class="form-label"></label>
                                <input asp-for="StockQuantity" type="number" min="0" class="form-control" placeholder="Enter stock quantity" />
                                <span asp-validation-for="StockQuantity" class="field-error"></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label asp-for="ProductDescription" class="form-label"></label>
                            <textarea asp-for="ProductDescription" class="form-control form-textarea" placeholder="Describe the product..."></textarea>
                            <span asp-validation-for="ProductDescription" class="field-error"></span>
                        </div>
                    </div>
                </div>

                <div class="form-col">
                    <div class="form-group">
                        <label class="form-label">Product Image</label>
                        <p class="form-sublabel">Upload a new image or keep the current one</p>

                        <div class="upload-dropzone" id="uploadArea"
                             ondragover="handleDragOver(event)"
                             ondragleave="handleDragLeave(event)"
                             ondrop="handleDrop(event)">

                            <div class="upload-dropzone-inner" id="uploadPlaceholder"
                                 onclick="document.getElementById('imageFile').click()"
                                 style="cursor:pointer; @(!string.IsNullOrEmpty(existingImage) ? "display:none;" : "")">
                                <div class="upload-icon-circle">
                                    <i class="fa-solid fa-arrow-up-from-bracket"></i>
                                </div>
                                <p class="upload-main-text">Drag and drop an image here<br>or click to browse</p>
                                <p class="upload-sub-text">PNG, JPEG, WEBP up to 5MB</p>
                            </div>

                            <div id="uploadPreviewWrapper" style="@(!string.IsNullOrEmpty(existingImage) ? "" : "display:none;") position:relative; width:100%; height:100%;">
                                <img id="uploadPreviewImg" src="@existingImage" alt="Product image"
                                     style="width:100%; height:100%; object-fit:contain; border-radius:10px; display:block; cursor:pointer;"
                                     onclick="document.getElementById('imageFile').click()" />
                                <button type="button" id="clearImageBtn" onclick="clearProductImage(event)" title="Remove image"
                                        style="position:absolute; top:8px; right:8px; width:26px; height:26px; border-radius:50%; border:none; background:rgba(80,40,130,0.8); color:#fff; font-size:14px; cursor:pointer; display:flex; align-items:center; justify-content:center; line-height:1; padding:0;">
                                    &times;
                                </button>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(existingImage))
                        {
                            <script>
                                document.getElementById('uploadArea').style.padding = '0';
                                document.getElementById('uploadArea').style.height = '220px';
                            </script>
                        }

                        <input type="file" id="imageFile" name="imageFile" accept="image/*" style="display:none;" onchange="handleImageUpload(this)" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Additional Showcase Images</label>
                        <p class="form-sublabel">Upload extra photos of your product</p>

                        <div class="additional-images-strip" id="additionalImagesStrip"
                             ondragover="additionalDragOver(event)"
                             ondragleave="additionalDragLeave(event)"
                             ondrop="additionalDrop(event)">

                            @if (Model.ProductImages != null && Model.ProductImages.Any())
                            {
                                foreach (var img in Model.ProductImages)
                                {
                                    <div class="additional-img-thumb" id="db-img-@img.ProductImageID">
                                        <img src="@img.ImagePath" alt="Additional image" />
                                        <button type="button" class="remove-thumb-btn" onclick="removeDatabaseImage(@img.ProductImageID)">
                                            &times;
                                        </button>
                                    </div>
                                }
                            }

                            <div class="additional-img-add" id="additionalImgAddTile" onclick="document.getElementById('additionalImagesInput').click()">
                                <span class="add-icon">&#43;</span>
                                <span class="add-label">Add Images</span>
                            </div>
                        </div>
                        <input type="file" id="additionalImagesInput" name="additionalImageFiles" accept="image/png,image/jpeg,image/webp" multiple style="display:none;" onchange="handleAdditionalImages(this)" />
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk"></i> Save Changes
                        </button>
                        <a asp-action="pIndex" class="btn btn-outline">Cancel</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Handle Primary Dropzone File changes
        function handleImageUpload(input) {
            if (!input.files || !input.files[0]) return;
            const file = input.files[0];

            const reader = new FileReader();
            reader.onload = function (e) {
                const dataUrl = e.target.result;
                document.getElementById('uploadPlaceholder').style.display = 'none';
                document.getElementById('uploadPreviewImg').src = dataUrl;
                document.getElementById('uploadPreviewWrapper').style.display = 'block';
                document.getElementById('uploadArea').style.padding = '0';
                document.getElementById('uploadArea').style.height = '220px';
            };
            reader.readAsDataURL(file);
        }

        function clearProductImage(e) {
            e.stopPropagation();
            document.getElementById('imageFile').value = '';
            document.getElementById('uploadPreviewImg').src = '';
            document.getElementById('uploadPreviewWrapper').style.display = 'none';
            document.getElementById('uploadPlaceholder').style.display = '';
            document.getElementById('uploadArea').style.padding = '';
            document.getElementById('uploadArea').style.height = '';
        }

        function handleDragOver(e) {
            e.preventDefault();
            document.getElementById('uploadArea').classList.add('drag-over');
        }
        function handleDragLeave(e) {
            document.getElementById('uploadArea').classList.remove('drag-over');
        }
        function handleDrop(e) {
            e.preventDefault();
            document.getElementById('uploadArea').classList.remove('drag-over');
            const file = e.dataTransfer.files[0];
            if (file && file.type.startsWith('image/')) {
                const input = document.getElementById('imageFile');
                const dt = new DataTransfer();
                dt.items.add(file);
                input.files = dt.files;
                handleImageUpload(input);
            }
        }

        // Additional Image Strip updates
        function handleAdditionalImages(input) {
            if (!input.files) return;
            Array.from(input.files).forEach(file => {
                const reader = new FileReader();
                reader.onload = e => addAdditionalThumb(e.target.result);
                reader.readAsDataURL(file);
            });
        }

        function addAdditionalThumb(src) {
            const strip = document.getElementById('additionalImagesStrip');
            const addTile = document.getElementById('additionalImgAddTile');

            const wrapper = document.createElement('div');
            wrapper.className = 'additional-img-thumb';

            const img = document.createElement('img');
            img.src = src;
            img.alt = 'Additional image';

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'remove-thumb-btn';
            btn.innerHTML = '&times;';
            btn.addEventListener('click', () => wrapper.remove());

            wrapper.appendChild(img);
            wrapper.appendChild(btn);
            strip.insertBefore(wrapper, addTile);
        }

        // Handles removing existing stored records from client visual view layout
        function removeDatabaseImage(id) {
            if (confirm("Are you sure you want to remove this showcase image?")) {
                const imgThumb = document.getElementById('db-img-' + id);
                if (imgThumb) {
                    imgThumb.remove();

                    // Optional: Create hidden input fields dynamically to let the backend controller
                    // know which Image IDs should be detached from the database upon form submit.
                    const hiddenInput = document.createElement('input');
                    hiddenInput.type = 'hidden';
                    hiddenInput.name = 'deletedImageIds';
                    hiddenInput.value = id;
                    document.forms[0].appendChild(hiddenInput);
                }
            }
        }

        function additionalDragOver(e) {
            e.preventDefault();
            document.getElementById('additionalImagesStrip').classList.add('drag-over');
        }
        function additionalDragLeave() {
            document.getElementById('additionalImagesStrip').classList.remove('drag-over');
        }
        function additionalDrop(e) {
            e.preventDefault();
            document.getElementById('additionalImagesStrip').classList.remove('drag-over');
            Array.from(e.dataTransfer.files)
                .filter(f => f.type.startsWith('image/'))
                .forEach(file => {
                    const reader = new FileReader();
                    reader.onload = ev => addAdditionalThumb(ev.target.result);
                    reader.readAsDataURL(file);
                });
        }

        // ── Size Dropdown List Multi-Select ────────────────────
        (function () {
            const hidden      = document.getElementById('sizeHidden');
            const items       = document.querySelectorAll('#sizeList .size-list-item');
            const triggerText = document.getElementById('sizeTriggerText');

            let selected = hidden.value
                ? hidden.value.split(',').map(s => s.trim()).filter(Boolean)
                : [];

            function syncDisplay() {
                hidden.value = selected.join(', ');
                triggerText.textContent = selected.length > 0 ? selected.join(', ') : 'Select Size';
            }

            // Pre-select saved sizes and restore trigger label on load
            syncDisplay();
            items.forEach(item => {
                if (selected.includes(item.dataset.size)) item.classList.add('selected');
                item.addEventListener('click', () => {
                    const size = item.dataset.size;
                    if (selected.includes(size)) {
                        selected = selected.filter(s => s !== size);
                        item.classList.remove('selected');
                    } else {
                        selected.push(size);
                        item.classList.add('selected');
                    }
                    syncDisplay();
                });
            });

            document.addEventListener('click', function (e) {
                if (!document.getElementById('sizeDropdown').contains(e.target)) {
                    closeSizeDropdown();
                }
            });
        })();

        function toggleSizeDropdown() {
            const panel   = document.getElementById('sizePanel');
            const chevron = document.getElementById('sizeChevron');
            const trigger = document.getElementById('sizeTrigger');
            const isOpen  = panel.classList.contains('open');
            panel.classList.toggle('open', !isOpen);
            chevron.classList.toggle('rotated', !isOpen);
            trigger.classList.toggle('active', !isOpen);
        }

        function closeSizeDropdown() {
            document.getElementById('sizePanel').classList.remove('open');
            document.getElementById('sizeChevron').classList.remove('rotated');
            document.getElementById('sizeTrigger').classList.remove('active');
        }
    </script>
}
