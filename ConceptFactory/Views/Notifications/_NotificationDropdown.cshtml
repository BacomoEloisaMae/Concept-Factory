@model IEnumerable<ConceptFactory.Models.Notification>
@using ConceptFactory.Models

@if (!Model.Any())
{
    <div class="notif-dropdown-empty"><i class="fa-solid fa-bell-slash"></i> No notifications yet.</div>
}
else
{
    foreach (var n in Model)
    {
        <div class="notif-dropdown-item @(n.IsRead ? "" : "notif-dropdown-item-unread")"
             onclick="cfOpenAdminNotification(@n.NotificationID, @n.OrderID)">
            <div class="notif-row-icon notif-color-@NotificationDisplay.ColorClass(n.Type)">
                <i class="fa-solid @NotificationDisplay.IconClass(n.Type)"></i>
            </div>
            <div class="notif-dropdown-item-body">
                <div class="notif-dropdown-item-title">@n.Title</div>
                <div class="notif-dropdown-item-message">@n.Message</div>
                <div class="notif-dropdown-item-time">@n.CreatedAt.ToString("MMM d, h:mm tt")</div>
            </div>
        </div>
    }
}
<a asp-controller="Notifications" asp-action="nIndex" class="notif-dropdown-viewall">View all notifications</a>
