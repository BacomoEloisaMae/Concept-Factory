@model ConceptFactory.Models.Order
@{
    Layout = null;
    ViewData["Title"] = "Receipt #" + Model.PaymentID;
    bool isFullyPaid = Model.PaymentStatus == "Fully Paid";
    bool isCash = Model.PaymentMethod == "Cash";
    decimal amountThisReceipt = isFullyPaid ? Model.TotalAmount : Model.DownPaymentAmount;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin/print-document.css" asp-append-version="true" />
    <!-- print-document.css used on this page: .pd-toolbar, .pd-btn-print, .pd-btn-close, .pd-page, .pd-header, .pd-brand, .pd-brand-name, .pd-brand-tagline, .pd-doc-title, .pd-doc-number, .pd-doc-date, .pd-stamp, .pd-info-row, .pd-info-block, .pd-info-main, .pd-payment-box, .pd-payment-row, .pd-payment-amount, .pd-footer -->
</head>
<body>
    <div class="pd-toolbar no-print">
        <button type="button" class="pd-btn-print" onclick="window.print()"><i class="fa-solid fa-print"></i> Print</button>
        <button type="button" class="pd-btn-close" onclick="window.close()"><i class="fa-solid fa-xmark"></i> Close</button>
    </div>

    <div class="pd-page">
        <div class="pd-header">
            <div class="pd-brand">
                <img src="~/images/logo/Nlogo.png" alt="ConceptFactory" />
                <div>
                    <div class="pd-brand-name">ConceptFactory</div>
                    <div class="pd-brand-tagline">Custom Apparel Printing & Merchandise</div>
                </div>
            </div>
            <div class="pd-doc-title">
                <h1>Receipt</h1>
                <div class="pd-doc-number">#@Model.PaymentID</div>
                <div class="pd-doc-date">Issued @DateTime.Now.ToString("MMMM d, yyyy")</div>
                <span class="pd-stamp @(isFullyPaid ? "pd-stamp-paid" : "pd-stamp-partial")">
                    @(isFullyPaid ? "Paid in Full" : "Down Payment Received")
                </span>
            </div>
        </div>

        <div class="pd-info-row">
            <div class="pd-info-block">
                <h4>Received From</h4>
                <p class="pd-info-main">@Model.CustomerName</p>
                <p>@(string.IsNullOrEmpty(Model.CustomerEmail) ? "—" : Model.CustomerEmail)</p>
                <p>@(string.IsNullOrEmpty(Model.CustomerPhone) ? "—" : Model.CustomerPhone)</p>
            </div>
            <div class="pd-info-block">
                <h4>Order Reference</h4>
                <p><strong>Order #:</strong> ORD-@Model.OrderID.ToString("D3")</p>
                <p><strong>Order Date:</strong> @Model.OrderDate.ToString("MMMM d, yyyy")</p>
            </div>
        </div>

        <div class="pd-info-block" style="margin-bottom: 20px;">
            <h4>Payment Information</h4>
            <p><strong>Payment Method:</strong> @(Model.PaymentMethod ?? "—")</p>
            @if (!isCash && !string.IsNullOrEmpty(Model.ReferenceNumber))
            {
                <p><strong>Reference #:</strong> @Model.ReferenceNumber</p>
            }
            @if (isCash && Model.CashAmountReceived.HasValue)
            {
                <p><strong>Cash Received:</strong> ₱@Model.CashAmountReceived.Value.ToString("N2")</p>
                <p><strong>Change Given:</strong> ₱@Math.Max(0, Model.CashAmountReceived.Value - Model.DownPaymentAmount).ToString("N2")</p>
            }
        </div>

        <div class="pd-payment-box">
            <div class="pd-payment-row"><span>Total Order Amount</span><span>₱@Model.TotalAmount.ToString("N2")</span></div>
            @if (!isFullyPaid)
            {
                <div class="pd-payment-row"><span>Remaining Balance</span><span>₱@Model.RemainingBalance.ToString("N2")</span></div>
            }
            <div class="pd-payment-row pd-payment-amount">
                <span>@(isFullyPaid ? "Total Amount Received" : "Amount Received (Down Payment)")</span>
                <span>₱@amountThisReceipt.ToString("N2")</span>
            </div>
        </div>

        <div class="pd-footer">
            This receipt confirms payment recorded against the order above. Thank you for choosing ConceptFactory!
        </div>
    </div>
</body>
</html>
