@model IEnumerable<ConceptFactory.Models.Order>
@using ConceptFactory.Models
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Orders";
    ViewData["ActivePage"] = "Orders";

    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    int pageSize = 10;
    int startItem = totalCount == 0 ? 0 : ((page - 1) * pageSize) + 1;
    int endItem = Math.Min(page * pageSize, totalCount);
    string currentTab = ViewBag.Tab ?? "All";
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin/orders.css" asp-append-version="true" />
    <!-- orders.css used on this page: .page-container, .page-header, .stat-cards-row, .stat-card, .stat-card-clickable, .stat-card-purple, .stat-card-label, .stat-card-body, .stat-icon-purple, .stat-icon, .stat-value, .stat-card-green, .stat-icon-green, .stat-card-orange, .stat-icon-orange, .stat-card-blue, .stat-icon-blue, .stat-card-red, .stat-icon-red, .filter-bar-flat, .filter-bar, .filter-date-narrow, .data-table, .orders-empty-state, .order-row-clickable, .order-id-link, .id-link-static, .order-products-cell, .status-badge, .order-date-cell, .order-time, .inline-form, .btn-icon-danger, .pagination, .billing-modal-backdrop, .om-modal, .billing-modal -->
    <link rel="stylesheet" href="~/css/admin/billing.css" asp-append-version="true" />
    <!-- billing.css used on this page: .btn, .billing-modal-backdrop, .billing-modal, .billing-modal-loading, .reason-confirm-backdrop, .reason-confirm-modal, .reason-confirm-icon, .reason-confirm-title, .reason-confirm-text, .reason-confirm-label, .reason-confirm-textarea, .reason-confirm-error, .reason-confirm-actions -->
}
<div class="page-container">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">Order Management</h1>
            <p class="page-subtitle">View and Manage all customer orders</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <!-- Stat Cards -->
    <div class="stat-cards-row">
        <a asp-action="oIndex" asp-route-search="@ViewBag.Search"
           class="stat-card stat-card-purple stat-card-clickable @(currentTab == "All" ? "active" : "")">
            <span class="stat-card-label">Total Orders</span>
            <div class="stat-card-body">
                <div class="stat-icon stat-icon-purple"><img src="~/images/logo/icons 1.png"></div>
                <span class="stat-value">@ViewBag.TotalOrders</span>
            </div>
        </a>
        <a asp-action="oIndex" asp-route-tab="Completed" asp-route-search="@ViewBag.Search"
           class="stat-card stat-card-green stat-card-clickable @(currentTab == "Completed" ? "active" : "")">
            <span class="stat-card-label">Completed</span>
            <div class="stat-card-body">
                <div class="stat-icon stat-icon-green"><img src="~/images/logo/image 24.png"></div>
                <span class="stat-value">@ViewBag.CompletedCount</span>
            </div>
        </a>
        <a asp-action="oIndex" asp-route-tab="InProduction" asp-route-search="@ViewBag.Search" ;
           class="stat-card stat-card-orange stat-card-clickable @(currentTab == "InProduction" ? "active" : "")">
            <span class="stat-card-label">In Production</span>
            <div class="stat-card-body">
                <div class="stat-icon stat-icon-orange"><img src="~/images/logo/production 2.png"></div>
                <span class="stat-value">@ViewBag.InProductionCount</span>
            </div>
        </a>
        <a asp-action="oIndex" asp-route-tab="Processing" asp-route-search="@ViewBag.Search"
           class="stat-card stat-card-blue stat-card-clickable @(currentTab == "Processing" ? "active" : "")">
            <span class="stat-card-label">Processing</span>
            <div class="stat-card-body">
                <div class="stat-icon stat-icon-blue stat-card-clickable"><img src="~/images/logo/process 1.png"></div>
                <span class="stat-value">@ViewBag.ProcessingCount</span>
            </div>
        </a>
        <a asp-action="oIndex" asp-route-tab="Cancel" asp-route-search="@ViewBag.Search"
           class="stat-card stat-card-red stat-card-clickable@(currentTab == "Cancel" ? "active" : "")">
            <span class="stat-card-label">Cancelled</span>
            <div class="stat-card-body">
                <div class="stat-icon stat-icon-red"><img src="~/images/logo/image 59.png"></div>
                <span class="stat-value">@ViewBag.CancelledCount</span>
            </div>
        </a>
    </div>

    <!-- Filters -->
    <div class="filter-bar filter-bar-flat">
        <form method="get" asp-action="oIndex" class="filter-form">
            <input type="hidden" name="tab" value="@ViewBag.Tab" />
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Search Order ID, customer, product..." class="search-input" />
            </div>
            <select name="paymentStatus" class="filter-select">
                <option value="" selected="@(ViewBag.PaymentStatus == null)">All Status</option>
                <option value="Waiting for Verification" selected="@(ViewBag.PaymentStatus == "Waiting for Verification")">Waiting for Verification</option>
                <option value="Partially Paid" selected="@(ViewBag.PaymentStatus == "Partially Paid")">Partially Paid</option>
                <option value="Fully Paid" selected="@(ViewBag.PaymentStatus == "Fully Paid")">Fully Paid</option>
                <option value="Rejected" selected="@(ViewBag.PaymentStatus == "Rejected")">Rejected</option>
            </select>
            <input type="date" name="date" value="@(ViewBag.Date != null ? ((DateTime)ViewBag.Date).ToString("yyyy-MM-dd") : "")" class="filter-select filter-date-narrow" />
            <button type="submit" class="btn btn-outline">
                <i class="fa-solid fa-filter"></i> Filter
            </button>
        </form>
    </div>

    <!-- Table Card -->
    <div class="card">
        <!-- Orders Table -->
        <table class="data-table">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Payment ID</th>
                    <th>Customer</th>
                    <th>Products</th>
                    <th>Total Amount</th>
                    <th>Payment</th>
                    <th>Status</th>
                    <th>Order Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9">
                            <div class="orders-empty-state">
                                <i class="fa-solid fa-bag-shopping"></i>
                                <p>No orders found.</p>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var o in Model)
                {
                    bool canCancel = o.Status != "Completed" && o.Status != "Cancelled"
                    && o.Status != "In Production" && o.Status != "Ready for Pickup";
                    <tr id="order-row-@o.OrderID" class="order-row-clickable" onclick="loadOrderDetails(@o.OrderID)">
                        <td><span class="order-id-link">#ORD-@o.OrderID.ToString("D3")</span></td>
                        <td><span class="order-id-link id-link-static" title="Payment record for this order — same number, different prefix">#@o.PaymentID</span></td>
                        <td>@o.CustomerName</td>
                        <td class="order-products-cell">
                            @Html.Raw(string.Join("<br />", o.OrderDetails.Select(d => $"{d.Quantity}x {(string.IsNullOrEmpty(d.ProductNameSnapshot) ? (d.Product != null ? d.Product.ProductName : "Item") : d.ProductNameSnapshot)}")))
                        </td>
                        <td>₱@o.TotalAmount.ToString("N2")</td>
                        <td>
                            <span class="status-badge @OrderStatusDisplay.PaymentBadgeClass(o.PaymentStatus)">
                                @o.PaymentStatus
                            </span>
                        </td>
                        <td>
                            <span class="status-badge @OrderStatusDisplay.BadgeClass(o.Status)">@o.Status</span>
                        </td>
                        <td class="order-date-cell">
                            @o.OrderDate.ToString("MMMM d, yyyy")
                            <span class="order-time">@o.OrderDate.ToString("h:mm tt")</span>
                        </td>
                        <td onclick="event.stopPropagation()">
                            <div class="action-btn">
                                @if (canCancel)
                                {
                                    <form asp-action="oUpdateStatus" method="post" class="inline-form" data-confirm-cancel="1">
                                        <input type="hidden" name="id" value="@o.OrderID" />
                                        <input type="hidden" name="status" value="Cancelled" />
                                        <input type="hidden" name="reason" class="cancel-reason-input" />
                                        <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                        <button type="submit" class="btn-icon btn-icon-danger" title="Cancel Order">
                                            <i class="fa-solid fa-ban"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="pagination">
                <span class="page-info">Showing @startItem - @endItem of @totalCount orders</span>
                <div class="page-btns">
                    @if (page > 1)
                    {
                        <a asp-action="oIndex" asp-route-page="@(page - 1)" asp-route-tab="@ViewBag.Tab"
                           asp-route-search="@ViewBag.Search" asp-route-paymentStatus="@ViewBag.PaymentStatus" asp-route-date="@ViewBag.Date" class="page-btn">‹</a>
                    }
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <a asp-action="oIndex" asp-route-page="@i" asp-route-tab="@ViewBag.Tab"
                           asp-route-search="@ViewBag.Search" asp-route-paymentStatus="@ViewBag.PaymentStatus" asp-route-date="@ViewBag.Date"
                           class="page-btn @(i == page ? "active" : "")">@i</a>
                    }
                    @if (page < totalPages)
                    {
                        <a asp-action="oIndex" asp-route-page="@(page + 1)" asp-route-tab="@ViewBag.Tab"
                           asp-route-search="@ViewBag.Search" asp-route-paymentStatus="@ViewBag.PaymentStatus" asp-route-date="@ViewBag.Date" class="page-btn">›</a>
                    }
                </div>
            </div>
        }
        else if (totalCount > 0)
        {
            <div class="pagination">
                <span class="page-info">Showing @startItem - @endItem of @totalCount orders</span>
            </div>
        }
    </div>
</div>

<!-- Order Details modal (view-only: customer info, order info, product
     details, uploaded design, payment summary, production progress) -->
<div class="billing-modal-backdrop" id="orderModalBackdrop" onclick="if(event.target===this) closeOrderModal()">
    <div class="billing-modal om-modal" id="orderModal">
        <div class="billing-modal-loading"><i class="fa-solid fa-spinner fa-spin"></i> Loading order details…</div>
    </div>
</div>

<!-- "Cancel Order" confirmation modal — requires a reason before it
     actually submits; the reason is included in the notification sent to
     the customer. -->
<div class="reason-confirm-backdrop" id="cancelConfirmBackdrop" onclick="if(event.target===this) closeCancelConfirm()">
    <div class="reason-confirm-modal">
        <div class="reason-confirm-icon"><i class="fa-solid fa-ban"></i></div>
        <div class="reason-confirm-title">Cancel this order?</div>
        <div class="reason-confirm-text">This cannot be undone. Let the customer know why below — this is included in the notification sent to them.</div>
        <label class="reason-confirm-label" for="cancelReasonInput">Reason for cancellation</label>
        <textarea id="cancelReasonInput" class="reason-confirm-textarea" maxlength="300" placeholder="e.g. Customer requested cancellation"></textarea>
        <div class="reason-confirm-error" id="cancelReasonError">Please enter a reason before cancelling.</div>
        <div class="reason-confirm-actions">
            <button type="button" class="btn btn-outline" onclick="closeCancelConfirm()">Go Back</button>
            <button type="button" class="btn btn-danger" onclick="confirmCancelOrder()">Yes, Cancel Order</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/orders-index.js" asp-append-version="true"></script>
}