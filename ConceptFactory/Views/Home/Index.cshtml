@{
    ViewData["Title"] = "Home";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ConceptFactory — Bring Your Ideas to Life</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --primary: #5B5EF4;
            --primary-dark: #4547d4;
            --primary-light: #EEEEFF;
            --accent: #7C3AED;
            --white: #ffffff;
            --text-main: #1e293b;
            --text-sub: #64748b;
            --text-muted: #94a3b8;
            --border: #e2e8f0;
            --bg: #f8fafc;
            --radius: 10px;
            --shadow: 0 1px 4px rgba(0,0,0,.08);
            --shadow-md: 0 4px 16px rgba(0,0,0,.10);
        }

        html { scroll-behavior: smooth; }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 14px;
            color: var(--text-main);
            background: var(--white);
            overflow-x: hidden;
        }

        /* ════════════════════════════════════════
           NAVBAR
        ════════════════════════════════════════ */
        .navbar {
            position: sticky;
            top: 0;
            z-index: 200;
            background: var(--white);
            border-bottom: 1px solid var(--border);
            padding: 0 48px;
            height: 62px;
            display: flex;
            align-items: center;
            gap: 32px;
            box-shadow: 0 1px 6px rgba(0,0,0,.06);
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 9px;
            text-decoration: none;
            flex-shrink: 0;
        }
        .nav-brand img { width: 36px; height: 38px; }
        .nav-brand-name {
            font-size: 13.5px;
            font-weight: 700;
            color: var(--text-main);
            line-height: 1.25;
        }
        .nav-brand-name span { display: block; font-weight: 500; font-size: 10.5px; color: var(--text-muted); }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 4px;
            flex: 1;
        }
        .nav-link {
            padding: 6px 13px;
            font-size: 13px;
            font-weight: 500;
            color: var(--text-sub);
            text-decoration: none;
            border-radius: 7px;
            transition: color .15s, background .15s;
        }
        .nav-link:hover { color: var(--text-main); background: var(--bg); }
        .nav-link.active { color: var(--primary); font-weight: 600; }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }
        .search-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            border: 1.5px solid var(--border);
            border-radius: 8px;
            padding: 6px 13px;
            background: var(--bg);
            width: 190px;
            transition: border-color .2s, box-shadow .2s;
        }
        .search-bar:focus-within { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(91,94,244,.08); }
        .search-bar i { color: var(--text-muted); font-size: 12px; }
        .search-bar input {
            border: none; background: none; outline: none;
            font-size: 12.5px; font-family: inherit; color: var(--text-main); width: 100%;
        }
        .search-bar input::placeholder { color: var(--text-muted); }

        .nav-icon-btn {
            width: 34px; height: 34px;
            border: 1.5px solid var(--border);
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            color: var(--text-sub);
            font-size: 13px;
            text-decoration: none;
            transition: border-color .15s, color .15s, background .15s;
            position: relative;
        }
        .nav-icon-btn:hover { border-color: var(--primary); color: var(--primary); background: var(--primary-light); }
        .cart-badge {
            position: absolute;
            top: -5px; right: -5px;
            width: 16px; height: 16px;
            background: var(--primary);
            color: var(--white);
            font-size: 9px;
            font-weight: 700;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            border: 2px solid var(--white);
        }

        .btn-nav-account {
            display: flex; align-items: center; gap: 7px;
            padding: 7px 16px;
            background: var(--primary);
            color: var(--white);
            border: none;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            text-decoration: none;
            transition: background .15s, box-shadow .15s;
            box-shadow: 0 3px 10px rgba(91,94,244,.3);
        }
        .btn-nav-account:hover { background: var(--primary-dark); }

        /* Avatar row for logged-in state (hidden by default in UI mockup) */
        .nav-avatars {
            display: flex;
            align-items: center;
        }
        .nav-avatars img {
            width: 26px; height: 26px;
            border-radius: 50%;
            border: 2px solid var(--white);
            margin-left: -8px;
            background: #c7caff;
        }
        .nav-avatars img:first-child { margin-left: 0; }
        .nav-count {
            font-size: 11px;
            font-weight: 700;
            color: var(--text-sub);
            margin-left: 8px;
        }

        /* ════════════════════════════════════════
           HERO
        ════════════════════════════════════════ */
        .hero {
            background: linear-gradient(135deg, #EEF0FF 0%, #E8EAFF 50%, #DFE2FF 100%);
            position: relative;
            overflow: hidden;
            min-height: 340px;
            display: flex;
            align-items: center;
            padding: 48px 64px;
        }

        /* Dot grid overlay */
        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle, #9496d0 1px, transparent 1px);
            background-size: 28px 28px;
            opacity: .22;
            pointer-events: none;
        }

        /* Decorative blob */
        .hero-blob {
            position: absolute;
            width: 520px; height: 520px;
            background: radial-gradient(circle, rgba(91,94,244,.18) 0%, transparent 70%);
            top: -120px; right: -80px;
            pointer-events: none;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 420px;
        }
        .hero-eyebrow {
            font-size: 11.5px;
            font-weight: 600;
            color: var(--primary);
            letter-spacing: .5px;
            text-transform: uppercase;
            margin-bottom: 10px;
            opacity: 0;
            animation: fadeSlideUp .5s .1s ease both;
        }
        .hero-title {
            font-size: 42px;
            font-weight: 800;
            line-height: 1.13;
            color: var(--text-main);
            margin-bottom: 14px;
            opacity: 0;
            animation: fadeSlideUp .5s .2s ease both;
        }
        .hero-title .accent {
            color: var(--primary);
            font-style: italic;
        }
        .hero-desc {
            font-size: 13.5px;
            color: var(--text-sub);
            line-height: 1.7;
            margin-bottom: 24px;
            max-width: 340px;
            opacity: 0;
            animation: fadeSlideUp .5s .3s ease both;
        }
        .hero-btns {
            display: flex;
            gap: 12px;
            opacity: 0;
            animation: fadeSlideUp .5s .4s ease both;
        }
        .btn-hero-primary {
            padding: 11px 26px;
            background: var(--primary);
            color: var(--white);
            border: none;
            border-radius: var(--radius);
            font-size: 13.5px;
            font-weight: 700;
            font-family: inherit;
            cursor: pointer;
            text-decoration: none;
            transition: background .2s, transform .15s, box-shadow .2s;
            box-shadow: 0 4px 14px rgba(91,94,244,.35);
        }
        .btn-hero-primary:hover { background: var(--primary-dark); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(91,94,244,.4); }

        .btn-hero-outline {
            padding: 10px 22px;
            background: var(--white);
            color: var(--text-main);
            border: 1.5px solid var(--border);
            border-radius: var(--radius);
            font-size: 13.5px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            text-decoration: none;
            transition: border-color .2s, box-shadow .2s, transform .15s;
        }
        .btn-hero-outline:hover { border-color: var(--primary); color: var(--primary); transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,0,0,.08); }

        /* Social proof */
        .hero-social {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 22px;
            opacity: 0;
            animation: fadeSlideUp .5s .5s ease both;
        }
        .hero-avatars {
            display: flex;
        }
        .hero-avatars span {
            width: 28px; height: 28px;
            border-radius: 50%;
            border: 2px solid var(--white);
            margin-left: -8px;
            background: linear-gradient(135deg, #a5b4fc, #818cf8);
            display: flex; align-items: center; justify-content: center;
            font-size: 11px;
            font-weight: 700;
            color: var(--white);
        }
        .hero-avatars span:first-child { margin-left: 0; }
        .hero-social-text { font-size: 12px; color: var(--text-sub); font-weight: 500; }
        .hero-social-text strong { color: var(--text-main); }

        /* Hero image cluster */
        .hero-visuals {
            position: absolute;
            right: 48px;
            top: 50%;
            transform: translateY(-50%);
            z-index: 2;
            display: flex;
            align-items: center;
            gap: 0;
            opacity: 0;
            animation: fadeIn .7s .3s ease both;
        }

        .mockup-tshirt {
            width: 200px;
            filter: drop-shadow(0 16px 32px rgba(91,94,244,.2));
            animation: floatY 4s ease-in-out infinite;
            position: relative;
            z-index: 3;
        }
        .mockup-tote {
            width: 130px;
            position: absolute;
            bottom: -30px;
            left: -60px;
            z-index: 2;
            filter: drop-shadow(0 8px 18px rgba(0,0,0,.12));
            animation: floatY 5s ease-in-out infinite reverse;
        }
        .printer-box {
            width: 160px;
            position: absolute;
            bottom: -20px;
            right: -40px;
            z-index: 1;
        }

        /* Floating feature badges on the hero */
        .hero-badge {
            position: absolute;
            background: var(--white);
            border-radius: 10px;
            padding: 8px 13px;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 16px rgba(0,0,0,.1);
            font-size: 11.5px;
            font-weight: 600;
            color: var(--text-main);
            z-index: 4;
            animation: floatY 6s ease-in-out infinite;
        }
        .hero-badge i { font-size: 14px; color: var(--primary); }
        .hero-badge small { display: block; font-size: 10px; font-weight: 400; color: var(--text-muted); }
        .badge-1 { top: 28px; right: 330px; animation-delay: 0s; }
        .badge-2 { bottom: 40px; right: 290px; animation-delay: -2s; }
        .badge-3 { top: 50%; right: 20px; transform: translateY(-50%); animation-delay: -1s; }

        /* Printer SVG placeholder */
        .printer-svg {
            width: 160px;
            height: 100px;
            background: linear-gradient(135deg, #1e293b, #334155);
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
        }
        .printer-svg i { font-size: 36px; color: rgba(255,255,255,.6); }

        /* ════════════════════════════════════════
           FEATURE STRIP
        ════════════════════════════════════════ */
        .features-strip {
            background: var(--white);
            border-bottom: 1px solid var(--border);
            padding: 20px 64px;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0;
        }
        .feature-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 24px 8px 0;
            border-right: 1px solid var(--border);
        }
        .feature-item:last-child { border-right: none; padding-right: 0; padding-left: 24px; }
        .feature-item:first-child { padding-left: 0; }
        .feature-icon {
            width: 38px; height: 38px;
            background: var(--primary-light);
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }
        .feature-icon i { font-size: 16px; color: var(--primary); }
        .feature-label { font-size: 13px; font-weight: 700; color: var(--text-main); margin-bottom: 2px; }
        .feature-desc  { font-size: 11.5px; color: var(--text-muted); line-height: 1.4; }

        /* ════════════════════════════════════════
           CATEGORY SECTION
        ════════════════════════════════════════ */
        .section {
            padding: 48px 64px;
        }
        .section-header {
            text-align: center;
            margin-bottom: 28px;
        }
        .section-eyebrow {
            font-size: 11.5px;
            font-weight: 600;
            color: var(--primary);
            letter-spacing: .5px;
            text-transform: uppercase;
            margin-bottom: 6px;
        }
        .section-title {
            font-size: 26px;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 6px;
        }
        .section-sub {
            font-size: 13px;
            color: var(--text-sub);
        }

        .categories-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 12px;
        }

        .cat-card {
            background: var(--white);
            border: 1.5px solid var(--border);
            border-radius: 14px;
            padding: 18px 12px 14px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            transition: border-color .2s, box-shadow .2s, transform .2s;
            text-decoration: none;
            color: inherit;
        }
        .cat-card:hover {
            border-color: var(--primary);
            box-shadow: 0 6px 20px rgba(91,94,244,.12);
            transform: translateY(-3px);
        }
        .cat-thumb {
            width: 64px; height: 64px;
            display: flex; align-items: center; justify-content: center;
        }
        .cat-thumb img { width: 100%; height: 100%; object-fit: contain; }
        .cat-thumb .cat-icon-placeholder {
            width: 54px; height: 54px;
            background: var(--primary-light);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 22px;
        }
        .cat-name { font-size: 12.5px; font-weight: 700; color: var(--text-main); text-align: center; }
        .cat-sub  { font-size: 10.5px; color: var(--text-muted); text-align: center; line-height: 1.4; }

        .view-all-wrap {
            text-align: center;
            margin-top: 22px;
        }
        .btn-view-all {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 22px;
            border: 1.5px solid var(--border);
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            color: var(--primary);
            text-decoration: none;
            background: var(--white);
            transition: border-color .2s, background .2s, box-shadow .2s;
            font-family: inherit;
            cursor: pointer;
        }
        .btn-view-all:hover { border-color: var(--primary); background: var(--primary-light); box-shadow: 0 2px 8px rgba(91,94,244,.1); }

        /* ════════════════════════════════════════
           FOOTER STRIP
        ════════════════════════════════════════ */
        .footer-strip {
            background: var(--text-main);
            color: rgba(255,255,255,.55);
            padding: 18px 64px;
            text-align: center;
            font-size: 12px;
        }
        .footer-strip a { color: rgba(255,255,255,.7); text-decoration: none; }
        .footer-strip a:hover { color: var(--white); }

        /* ════════════════════════════════════════
           ANIMATIONS
        ════════════════════════════════════════ */
        @@keyframes fadeSlideUp {
            from { opacity: 0; transform: translateY(18px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @@keyframes fadeIn {
            from { opacity: 0; }
            to   { opacity: 1; }
        }
        @@keyframes floatY {
            0%, 100% { transform: translateY(0); }
            50%       { transform: translateY(-12px); }
        }

        /* ════════════════════════════════════════
           RESPONSIVE (basic)
        ════════════════════════════════════════ */
        @@media (max-width: 1100px) {
            .categories-grid { grid-template-columns: repeat(4, 1fr); }
            .hero-visuals { right: 24px; }
            .features-strip { grid-template-columns: repeat(2, 1fr); }
        }
        @@media (max-width: 860px) {
            .navbar { padding: 0 20px; gap: 16px; }
            .nav-links { display: none; }
            .hero { padding: 40px 24px; min-height: auto; }
            .hero-visuals { display: none; }
            .hero-badge { display: none; }
            .section { padding: 32px 24px; }
            .features-strip { padding: 16px 24px; grid-template-columns: repeat(2, 1fr); }
            .categories-grid { grid-template-columns: repeat(3, 1fr); }
            .hero-title { font-size: 30px; }
        }
    </style>
</head>
<body>

<!-- ═══════════════════════════════════
     NAVBAR
═══════════════════════════════════ -->
<nav class="navbar">
    <a href="/" class="nav-brand">
        <img src="/images/logo/logo.png" alt="ConceptFactory" />
        <span class="nav-brand-name">
            Concept Factory
            <span>Custom printing for every style</span>
        </span>
    </a>

    <div class="nav-links">
        <a href="/" class="nav-link active">Home</a>
        <a href="#" class="nav-link">Products</a>
        <a href="#" class="nav-link">Customize</a>
        <a href="#" class="nav-link">Track Order</a>
        <a href="#" class="nav-link">Bulk Order</a>
        <a href="#" class="nav-link">About Us</a>
        <a href="#" class="nav-link">Contact</a>
    </div>

    <div class="nav-right">
        <div class="search-bar">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="Search products..." />
        </div>
        <a href="#" class="nav-icon-btn" title="Wishlist">
            <i class="fa-regular fa-heart"></i>
        </a>
        <a href="#" class="nav-icon-btn" title="Cart">
            <i class="fa-solid fa-cart-shopping"></i>
            <span class="cart-badge">3</span>
        </a>
        <a href="/Auth/Login" class="btn-nav-account">
            <i class="fa-regular fa-user"></i>
            My Account
        </a>
    </div>
</nav>

<!-- ═══════════════════════════════════
     HERO
═══════════════════════════════════ -->
<section class="hero">
    <div class="hero-blob"></div>

    <div class="hero-content">
        <p class="hero-eyebrow">Welcome to Concept Factory</p>
        <h1 class="hero-title">
            Bring your Ideas<br>
            to <span class="accent">Life.</span>
        </h1>
        <p class="hero-desc">
            High quality custom printing for every style, every story.
            Design by you. Printed by us.
        </p>
        <div class="hero-btns">
            <a href="#" class="btn-hero-primary">Shop Now</a>
            <a href="#" class="btn-hero-outline">Customize Now</a>
        </div>

        <div class="hero-social">
            <div class="hero-avatars">
                <span>A</span>
                <span>B</span>
                <span>C</span>
                <span>D</span>
            </div>
            <span class="hero-social-text"><strong>1,000+</strong> Happy Customers</span>
        </div>
    </div>

    <!-- Floating product visuals -->
    <div class="hero-visuals">
        <div style="position:relative; width:220px; height:280px;">
            <img src="/images/mockups/tshirt.svg" alt="T-Shirt Mockup" class="mockup-tshirt" style="position:absolute; top:0; right:0; width:200px;" />
            <img src="/images/mockups/totebag.svg" alt="Tote Bag" class="mockup-tote" />
        </div>
        <div style="margin-left:12px; margin-bottom:0; align-self:flex-end;">
            <div class="printer-svg">
                <i class="fa-solid fa-print"></i>
            </div>
        </div>
    </div>

    <!-- Floating badges -->
    <div class="hero-badge badge-1">
        <i class="fa-solid fa-palette"></i>
        <div>
            <div>Easy Customize</div>
            <small>Design your own print</small>
        </div>
    </div>
    <div class="hero-badge badge-2">
        <i class="fa-solid fa-truck-fast"></i>
        <div>
            <div>Fast Delivery</div>
            <small>Get it in 3–5 days</small>
        </div>
    </div>
    <div class="hero-badge badge-3">
        <i class="fa-solid fa-star" style="color:#f59e0b;"></i>
        <div>
            <div>Printed Quality</div>
            <small>Approved &amp; verified</small>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════
     FEATURE STRIP
═══════════════════════════════════ -->
<div class="features-strip">
    <div class="feature-item">
        <div class="feature-icon"><i class="fa-solid fa-medal"></i></div>
        <div>
            <div class="feature-label">High Quality Prints</div>
            <div class="feature-desc">Vivid colors and long lasting print</div>
        </div>
    </div>
    <div class="feature-item" style="padding-left:24px;">
        <div class="feature-icon"><i class="fa-solid fa-shirt"></i></div>
        <div>
            <div class="feature-label">Premium Materials</div>
            <div class="feature-desc">We use the best fabric for maximum comfort</div>
        </div>
    </div>
    <div class="feature-item" style="padding-left:24px;">
        <div class="feature-icon"><i class="fa-solid fa-truck-fast"></i></div>
        <div>
            <div class="feature-label">Fast &amp; Reliable Delivery</div>
            <div class="feature-desc">Quick turnaround and tracking updates</div>
        </div>
    </div>
    <div class="feature-item" style="padding-left:24px;">
        <div class="feature-icon"><i class="fa-solid fa-headset"></i></div>
        <div>
            <div class="feature-label">Customer Support</div>
            <div class="feature-desc">We're here to help you anytime</div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════
     CATEGORIES SECTION
═══════════════════════════════════ -->
<section class="section" style="background: var(--bg);">
    <div class="section-header">
        <p class="section-eyebrow">Shop by category</p>
        <h2 class="section-title">What are you looking for?</h2>
        <p class="section-sub">Browse our wide range of custom printed products</p>
    </div>

    <div class="categories-grid">
