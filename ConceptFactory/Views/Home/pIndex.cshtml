@using ConceptFactory.Models
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";

    string[] stageNames = ViewBag.StageNames;
    int[] stageCounts = ViewBag.StageCounts;
    int stageTotal = ViewBag.StageTotal;
    decimal[] weeklyRevenue = ViewBag.WeeklyRevenue;
    var recentOrders = (List<ConceptFactory.Models.Order>)ViewBag.RecentOrders;

    string[] stageColors = { "#5B5EF4", "#F59E0B", "#10B981", "#06B6D4", "#EC4899", "#8B5CF6" };
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin/orders.css" asp-append-version="true" />
    <!-- orders.css used on this page: .page-container, .page-header, .stat-cards-row, .stat-card, .stat-card-purple, .stat-card-label, .stat-card-body, .stat-icon-purple, .stat-icon, .stat-value, .stat-card-green, .stat-icon-green, .stat-card-orange, .stat-icon-orange, .stat-card-blue, .stat-icon-blue, .data-table, .orders-empty-state, .order-row-clickable, .order-id-link, .status-badge, .order-date-cell, .billing-modal-backdrop, .om-modal, .billing-modal -->
    <link rel="stylesheet" href="~/css/admin/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/production.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/billing.css" asp-append-version="true" />
    <!-- billing.css used on this page: .billing-modal-backdrop, .billing-modal, .billing-modal-loading -->

}
<div class="page-container">

    <div class="page-header">
        <div>
            <h1 class="page-title">Dashboard</h1>
            <p class="page-subtitle">Welcome back, Admin! Here's what's happening today.</p>
        </div>
        <div class="page-header-actions">
            <div class="dash-topbar">
                <form method="get" asp-controller="Orders" asp-action="oIndex" class="dash-topbar-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" name="search" class="dash-topbar-search-input" placeholder="Search orders..." />
                </form>

                <div class="admin-bell-wrap" id="adminBellWrap">
                    <button type="button" class="dash-topbar-icon-btn" onclick="toggleAdminNotifDropdown()" title="Notifications">
                        <i class="fa-solid fa-bell"></i>
                        <span id="adminBellBadge"></span>
                    </button>
                    <div class="admin-notif-dropdown" id="adminNotifDropdown">
                        <div class="admin-notif-dropdown-loading"><i class="fa-solid fa-spinner fa-spin"></i> Loading…</div>
                    </div>
                </div>

                @* <a asp-controller="Notifications" asp-action="nIndex" class="dash-topbar-icon-btn" title="Notifications inbox">
                    <i class="fa-solid fa-envelope"></i>
                </a> *@

                <div class="dash-topbar-date">
                    <i class="fa-regular fa-calendar"></i>
                    <span>@DateTime.Now.ToString("MMM d, yyyy")</span>
                    <i class="fa-solid fa-chevron-down"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="stat-cards-row dash-stat-cards-row">
        <div class="stat-card stat-card-purple">
            <span class="stat-card-label">Total Orders</span>
            <div class="stat-card-body">
                <div class="stat-icon stat-card-purple"><img src="~/images/logo/icons 1.png" /></div>
                <span class="stat-value">@ViewBag.TotalOrders</span>
            </div>
        </div>
        <div class="stat-card stat-card-green">
            <span class="stat-card-label">Completed Orders</span>
            <div class="stat-card-body">
                <div class="prod-monitor-icon stat-card-green"><img src="~/images/logo/image 24.png" /></div>
                <span class="stat-value">@ViewBag.CompletedOrders</span>
            </div>
        </div>
        <div class="stat-card stat-card-orange">
            <span class="stat-card-label">In Production</span>
            <div class="stat-card-body">
                <div class="prod-monitor-icon stat-card-orange"><img src="~/images/logo/production.png" /></div>
                <span class="stat-value">@ViewBag.InProduction</span>
            </div>
        </div>
        <div class="stat-card stat-card-yellow">
            <span class="stat-card-label">Pending Payment</span>
            <div class="stat-card-body">
                <div class="prod-monitor-icon stat-card-yellow"><img src="~/images/logo/pending 1.png" /></div>
                <span class="stat-value">@ViewBag.PendingPayment</span>
            </div>
        </div>
        <div class="stat-card stat-card-purple">
            <span class="stat-card-label">Total Revenue</span>
            <div class="stat-card-body">
                <div class="prod-monitor-icon stat-card-purple"><img src="~/images/logo/revenue 1.png" /></i></div>
                <span class="stat-value">₱@(((decimal)ViewBag.TotalRevenue).ToString("N2"))</span>
            </div>
        </div>
    </div>

    <!-- Production Overview — full width -->
    <div class="dash-grid-main">
        <div class="card dash-card">
            <div class="dash-card-header">
                <h2>Production Overview</h2>
                <span class="dash-period-badge"><span>This Month</span> <i class="fa-solid fa-chevron-down"></i></span>
            </div>
            @if (stageTotal == 0)
            {
                <div class="dash-empty"><i class="fa-solid fa-industry"></i> No orders in production right now.</div>
            }
            else
            {
                <div class="dash-donut-row">
                    <div class="dash-donut-wrap">
                        <canvas id="productionDonut" width="180" height="180"></canvas>
                        <div class="dash-donut-center">
                            <span class="dash-donut-value">@stageTotal</span>
                            <span class="dash-donut-label">Orders in<br />Production</span>
                        </div>
                    </div>
                    <div class="dash-legend">
                        @for (int i = 0; i < stageNames.Length; i++)
                        {
                            <div class="dash-legend-item">
                                <span class="dash-legend-dot" style="background:@stageColors[i]"></span>
                                <span class="dash-legend-label">@stageNames[i]</span>
                                <span class="dash-legend-value">
                                    @stageCounts[i] (@(stageTotal > 0 ? Math.Round(stageCounts[i] * 100.0 / stageTotal, 1) : 0)%)
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="card dash-card">
            <div class="dash-card-header">
                <h2>Revenue Overview</h2>
                <span class="dash-period-badge"><span>This Month</span> <i class="fa-solid fa-chevron-down"></i></span>
            </div>
            <div class="dash-revenue-total">
                <span class="dash-card-sub">Total Revenue</span>
                <span class="dash-revenue-value">₱@(((decimal)ViewBag.TotalRevenue).ToString("N2"))</span>
            </div>
            <div class="dash-revenue-chart-wrap">
                <canvas id="revenueBar"></canvas>
            </div>
        </div>

    </div>

    <!-- Recent Orders (2/3) + Revenue Overview (1/3) -->
        <div class="card dash-card">
            <div class="dash-card-header">
                <h2>Recent Orders</h2>
                <a asp-controller="Orders" asp-action="oIndex" class="dash-viewall">View All Orders</a>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Products</th>
                        <th>Status</th>
                        <th>Order Date</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!recentOrders.Any())
                    {
                        <tr><td colspan="6"><div class="orders-empty-state"><i class="fa-solid fa-cart-shopping"></i><p>No orders yet.</p></div></td></tr>
                    }
                    @foreach (var o in recentOrders)
                    {
                        var first = o.OrderDetails.FirstOrDefault();
                        int extra = o.OrderDetails.Count - 1;
                    <tr id="order-row-@o.OrderID" class="order-row-clickable" onclick="loadOrderDetails(@o.OrderID)">
                            <td><a asp-controller="Orders" asp-action="oDetails" asp-route-id="@o.OrderID" class="order-id-link" onclick="event.stopPropagation()">#ORD-@o.OrderID.ToString("D3")</a></td>
                            <td>@o.CustomerName</td>
                            <td>
                                @(first != null ? $"{first.Quantity}x {first.ProductNameSnapshot}" : "—")
                                @if (extra > 0)
                                {
                                    <span class="dash-extra-items">+@extra more</span>
                                }
                            </td>
                            <td><span class="status-badge @OrderStatusDisplay.BadgeClass(o.Status)">@o.Status</span></td>
                            <td class="order-date-cell">@o.OrderDate.ToString("MMM d, yyyy")</td>
                            <td>₱@o.TotalAmount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    <!-- Production Alerts (2/3) + System Overview (1/3) -->
    <div class="dash-grid-main">
        <div class="card dash-card">
            <div class="dash-card-header">
                <h2>Production Alerts</h2>
                <a asp-controller="Production" asp-action="pIndex" class="dash-viewall">View All Alerts</a>
            </div>
            <div class="dash-alerts">
                @if ((int)ViewBag.StalledCount > 0)
                {
                    <div class="dash-alert dash-alert-warning">
                        <div class="dash-alert-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
                        <div class="dash-alert-body">
                            <div class="dash-alert-title">@ViewBag.StalledCount order(s) still in production for more than 3 days.</div>
                            <div class="dash-alert-sub">Please check the production progress.</div>
                        </div>
                    </div>
                }
                @if ((int)ViewBag.WaitingVerificationCount > 0)
                {
                    <div class="dash-alert dash-alert-info">
                        <div class="dash-alert-icon"><i class="fa-solid fa-circle-info"></i></div>
                        <div class="dash-alert-body">
                            <div class="dash-alert-title">@ViewBag.WaitingVerificationCount order(s) waiting for payment confirmation.</div>
                            <div class="dash-alert-sub">Kindly verify and approve the payment.</div>
                        </div>
                    </div>
                }
                @if ((int)ViewBag.ReadyForPickupCount > 0)
                {
                    <div class="dash-alert dash-alert-success">
                        <div class="dash-alert-icon"><i class="fa-solid fa-circle-check"></i></div>
                        <div class="dash-alert-body">
                            <div class="dash-alert-title">@ViewBag.ReadyForPickupCount order(s) are ready for pickup.</div>
                            <div class="dash-alert-sub">Please notify the customers.</div>
                        </div>
                    </div>
                }
                @if ((int)ViewBag.StalledCount == 0 && (int)ViewBag.WaitingVerificationCount == 0 && (int)ViewBag.ReadyForPickupCount == 0)
                {
                    <div class="dash-empty"><i class="fa-solid fa-circle-check"></i> Nothing needs your attention right now.</div>
                }
            </div>
        </div>

        <div class="card dash-card">
            <div class="dash-card-header">
                <h2>System Overview</h2>
            </div>
            <div class="dash-grid-main dash-system-item-grid">
                <div class="dash-system-item">
                    <div class="stat-icon stat-icon-purple"><i class="fa-solid fa-shirt"></i></div>
                    <div>
                        <div class="dash-system-value">@ViewBag.TotalProducts</div>
                        <div class="dash-system-label">Total Products</div>
                    </div>
                </div>
                <div class="dash-system-item">
                    <div class="stat-icon stat-icon-blue"><i class="fa-solid fa-users"></i></div>
                    <div>
                        <div class="dash-system-value">@ViewBag.TotalCustomers</div>
                        <div class="dash-system-label">Total Staff</div>
                    </div>
                </div>
                <div class="dash-system-item">
                    <div class="stat-icon stat-icon-orange"><i class="fa-solid fa-user-gear"></i></div>
                    <div>
                        <div class="dash-system-value">@ViewBag.StaffCount</div>
                        <div class="dash-system-label">Total Customers</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Order Details Modal -->
<div class="billing-modal-backdrop"
     id="orderModalBackdrop"
     onclick="if(event.target===this) closeOrderModal()">

    <div class="billing-modal om-modal" id="orderModal">
        <div class="billing-modal-loading">
            <i class="fa-solid fa-spinner fa-spin"></i>
            Loading order details…
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.5.1/chart.umd.min.js"></script>
    <script src="~/js/admin/orders-index.js" asp-append-version="true"></script>
    <script>
        // Server-rendered data only — the CF_* inline-data convention used
        // across the storefront (see storefront.js). All page LOGIC lives
        // in wwwroot/js/admin/dashboard.js instead.
        window.CF_DASHBOARD = {
            stageLabels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stageNames)),
            stageData: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stageCounts)),
            stageColors: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stageColors)),
            weeklyRevenue: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(weeklyRevenue))
        };
    </script>
    <script src="~/js/admin/dashboard.js" asp-append-version="true"></script>
}
