@model ConceptFactory.Models.Order
@{
    bool fromTrack = (ViewBag.From as string) == "track";
    ViewData["Title"] = fromTrack ? "Track Order" : "Order Status";
}
@section Styles {
    <link rel="stylesheet" href="~/css/home/home-index.css" asp-append-version="true" />
    <!-- home-index.css used on this page: .cf-page, .js-hidden, .cf-page-title, .cf-page-sub -->
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home/order-details.css" asp-append-version="true" />
    @if (fromTrack)
    {
        <link rel="stylesheet" href="~/css/home/track-order-details.css" asp-append-version="true" />
        <!-- track-order-details.css used on this page: .cf-page, .cot-page, .cot-back-link, .cf-page-title, .cf-page-sub, .cot-actions-row, .cot-btn-outline, .cot-btn -->
    }
}
<div class="cf-page cot-page">
    <form id="cfAntiForgeryForm" class="js-hidden">@Html.AntiForgeryToken()</form>

    @if (fromTrack)
    {
        <a asp-action="hTrackOrder" class="cot-back-link"><i class="fa-solid fa-arrow-left"></i></a>
        <div class="cf-page-title">Track Order</div>
    }
    else
    {
        <div class="cf-page-title">Order Placed!</div>
        <div class="cf-page-sub">Thank you — here's the status of your order. You can come back to this any time from "Track Order".</div>
    }

    @await Html.PartialAsync("_CustomerOrderTrackingBody", Model)

    <div class="cot-actions-row">
        @if (fromTrack)
        {
            <a asp-action="hTrackOrder" class="cot-btn cot-btn-outline">Back to My Orders</a>
        }
        else
        {
            <a asp-action="hIndex" class="cot-btn cot-btn-outline">Continue Shopping</a>
            <a asp-action="hTrackOrder" class="cot-btn cot-btn-primary">Track Another Order</a>
        }
    </div>
</div>
