@model ConceptFactory.Models.Product
@{
    ViewData["Title"] = "Edit Item";
    ViewData["ActivePage"] = "Products";
    string existingImage = Model.ImagePath ?? "";
}

<div class="page-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">Edit Item</h1>
            <p class="page-subtitle">Update the item details below.</p>
        </div>
        <a asp-action="pIndex" class="btn btn-outline">
            <i class="fa-solid fa-arrow-left"></i> Back to Items
        </a>
    </div>

    <div class="form-card">
        <form asp-action="pEdit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProductID" />
            <input type="hidden" asp-for="DateAdded" />
            <input type="hidden" asp-for="ImagePath" />

            <div class="form-grid">
                <div class="form-col left">
                    <div class="form-header"><h2>Basic Information</h2></div>

                    <div class="form-group">
                        <label asp-for="ProductName" class="form-label">Item Name</label>
                        <input asp-for="ProductName" class="form-control" placeholder="e.g. Basic Cotton T-Shirt" />
                        <span asp-validation-for="ProductName" class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CategoryID" class="form-label">Category</label>
                        <select asp-for="CategoryID" asp-items="ViewBag.CategoryID" class="form-control">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CategoryID" class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Size</label>
                        <div class="size-dropdown" id="sizeDropdown">
                            <button type="button" class="size-dropdown-trigger" id="sizeTrigger" onclick="toggleSizeDropdown()">
                                <span id="sizeTriggerText">Select Size</span>
                                <i class="fa-solid fa-chevron-down size-chevron" id="sizeChevron"></i>
                            </button>
                            <div class="size-dropdown-panel" id="sizePanel">
                                <div class="size-list" id="sizeList">
                                    <div class="size-list-item" data-size="XS">XS</div>
                                    <div class="size-list-item" data-size="S">S</div>
                                    <div class="size-list-item" data-size="M">M</div>
                                    <div class="size-list-item" data-size="L">L</div>
                                    <div class="size-list-item" data-size="XL">XL</div>
                                    <div class="size-list-item" data-size="XXL">XXL</div>
                                    <div class="size-list-item" data-size="One Size">One Size</div>
                                </div>
                            </div>
                        </div>
                        <input type="hidden" id="sizeHidden" name="Size" value="@Model.Size" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Color Options</label>
                        <div class="color-picker-box">
                            <div class="color-picker-wrap" id="colorPickerWrap"></div>
                            <button type="button" class="btn-add-color" onclick="openColorPicker()">
                                <span class="btn-add-color-icon"><i class="fa-solid fa-plus"></i></span>
                                <span class="btn-add-color-label">Add Color</span>
                            </button>
                            <input type="color" id="nativeColorPicker"
                                   style="position:absolute; bottom:0; right:0; width:0; height:0; opacity:0; padding:0; border:none;"
                                   onchange="addColor(this.value)" oninput="addColor(this.value)" />
                        </div>
                        <input type="hidden" id="colorHidden" name="Color" value="@Model.Color" />
                    </div>

                    <div class="form-row-2">
                        <div class="form-group">
                            <label asp-for="Price" class="form-label"></label>
                            <div class="input-prefix">
                                <span class="prefix-text">₱</span>
                                <input asp-for="Price" type="number" step="0.01" min="0" class="form-control prefix-input" placeholder="Enter price" />
                            </div>
                            <span asp-validation-for="Price" class="field-error"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="StockQuantity" class="form-label"></label>
                            <input asp-for="StockQuantity" type="number" min="0" class="form-control" placeholder="Enter stock quantity" />
                            <span asp-validation-for="StockQuantity" class="field-error"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="ProductDescription" class="form-label"></label>
                        <textarea asp-for="ProductDescription" class="form-control form-textarea" placeholder="Describe the item..."></textarea>
                    </div>
                </div>

                <div class="form-col">
                    <div class="form-group">
                        <label class="form-label">Item Image</label>
                        <p class="form-sublabel">Upload a new image or keep the current one</p>

                        <div class="upload-dropzone" id="uploadArea"
                             ondragover="handleDragOver(event)"
                             ondragleave="handleDragLeave(event)"
                             ondrop="handleDrop(event)">

                            <div class="upload-dropzone-inner" id="uploadPlaceholder"
                                 onclick="document.getElementById('imageFile').click()"
                                 style="cursor:pointer; @(!string.IsNullOrEmpty(existingImage) ? "display:none;" : "")">
                                <div class="upload-icon-circle"><i class="fa-solid fa-arrow-up-from-bracket"></i></div>
                                <p class="upload-main-text">Drag and drop an image here<br>or click to browse</p>
                                <p class="upload-sub-text">PNG, JPEG, WEBP up to 5MB</p>
                            </div>

                            <div id="uploadPreviewWrapper"
                                 style="@(!string.IsNullOrEmpty(existingImage) ? "" : "display:none;") position:relative; width:100%; height:100%;">
                                <img id="uploadPreviewImg" src="@existingImage" alt="Item image"
                                     style="width:100%; height:100%; object-fit:contain; border-radius:10px; display:block; cursor:pointer;"
                                     onclick="document.getElementById('imageFile').click()" />
                                <button type="button" onclick="clearImage(event)" title="Remove image"
                                        style="position:absolute; top:8px; right:8px; width:26px; height:26px; border-radius:50%; border:none; background:rgba(80,40,130,.8); color:#fff; font-size:14px; cursor:pointer; display:flex; align-items:center; justify-content:center; padding:0;">
                                    &times;
                                </button>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(existingImage))
                        {
                            <script>
                                document.getElementById('uploadArea').style.padding = '0';
                                document.getElementById('uploadArea').style.height = '220px';
                            </script>
                        }

                        <input type="file" id="imageFile" name="imageFile" accept="image/*" style="display:none;" onchange="handleImageUpload(this)" />
                    </div>

                    <!-- ── Additional Images ── -->
                    <div class="form-group" style="margin-top:8px;">
                        <label class="form-label">Additional Images</label>

                        <input type="hidden" id="removedShowcaseImages" name="removedShowcaseImages" value="" />
                        <input type="hidden" asp-for="AdditionalImages" />
                        <input type="file" id="showcaseFiles" name="showcaseFiles" accept="image/*" multiple style="display:none;" />

                        <!-- 6 small slots -->
                        <div class="sc-grid" id="showcaseGrid">
                            @{
                                var existingPaths = Model.AdditionalImageList;
                            }
                            @for (int i = 0; i < 6; i++)
                            {
                                if (i < existingPaths.Count)
                                {
                                    <div class="sc-slot filled" id="scSlot@(i)" data-existing="@existingPaths[i]">
                                        <img src="@existingPaths[i]" alt="Showcase @(i+1)" />
                                        <button type="button" class="sc-slot-add-btn"
                                                onclick="event.stopPropagation();triggerSlotReplace(@i)" title="Change">
                                            <i class="fa-solid fa-plus"></i>
                                        </button>
                                        <button type="button" class="sc-slot-rm"
                                                onclick="event.stopPropagation();clearSlot(@i)" title="Remove">✕</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="sc-slot empty" id="scSlot@(i)" onclick="triggerSlotPick(@i)">
                                        <i class="fa-solid fa-plus sc-slot-icon"></i>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk"></i> Save Changes
                        </button>
                        <a asp-action="pIndex" class="btn btn-outline">Cancel</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<style>
/* ── Additional Images ── */
.sc-main-preview {
    width: 100%;
    height: 130px;
    border-radius: 12px;
    background: #e8eaff;
    border: 2px dashed #b8baff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 8px;
    transition: border-color .2s, background .2s;
    position: relative;
}
.sc-main-preview:hover { border-color: var(--primary); background: #dfe1ff; }
.sc-main-placeholder { display: flex; align-items: center; justify-content: center; }
.sc-main-placeholder i { font-size: 36px; color: #a5a8e8; }
.sc-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 6px;
}
.sc-slot {
    aspect-ratio: 1/1;
    border-radius: 8px;
    border: 1.5px dashed #c7caff;
    background: #f0f1ff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color .2s, background .2s;
    position: relative;
    overflow: hidden;
}
.sc-slot.empty:hover { border-color: var(--primary); background: #eef0ff; }
.sc-slot.empty .sc-slot-icon { font-size: 13px; color: #c7caff; transition: color .2s; }
.sc-slot.empty:hover .sc-slot-icon { color: var(--primary); }
.sc-slot.filled { border-style: solid; border-color: #c7caff; cursor: default; }
.sc-slot.filled img { width: 100%; height: 100%; object-fit: cover; display: block; }
.sc-slot-add-btn {
    position: absolute;
    bottom: 2px; right: 2px;
    width: 16px; height: 16px;
    border-radius: 50%;
    background: var(--primary);
    color: #fff;
    font-size: 8px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    border: 1.5px solid #fff;
}
.sc-slot-add-btn:hover { background: var(--primary-dark); }
.sc-slot-rm {
    position: absolute;
    top: 2px; right: 2px;
    width: 15px; height: 15px;
    border-radius: 50%;
    background: rgba(229,62,62,.88);
    color: #fff;
    font-size: 8px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    border: 1px solid #fff;
    font-weight: 700;
}
.sc-slot-rm:hover { background: #dc2626; }
</style>
<partial name="_ValidationScriptsPartial" />
    <script>
        // ── Color Swatch Picker ──────────────────────────────────────
        (function () {
            const hidden = document.getElementById('colorHidden');
            const wrap   = document.getElementById('colorPickerWrap');
            const picker = document.getElementById('nativeColorPicker');
            let colors   = hidden.value ? hidden.value.split(',').map(c => c.trim()).filter(Boolean) : [];

            function render() {
                wrap.innerHTML = '';
                colors.forEach((hex, i) => {
                    const sw  = document.createElement('div');
                    sw.className    = 'color-swatch';
                    sw.style.background = hex;
                    sw.title        = hex;
                    const rm  = document.createElement('span');
                    rm.className    = 'rm';
                    rm.textContent  = '×';
                    rm.onclick = e => { e.stopPropagation(); colors.splice(i, 1); sync(); render(); };
                    sw.appendChild(rm);
                    wrap.appendChild(sw);
                });
            }

            function sync() { hidden.value = colors.join(', '); }

            // Exposed globally so the button can call it
            window.openColorPicker = function () { picker.click(); };

            picker.addEventListener('change', function () {
                const hex = this.value;
                if (hex && !colors.includes(hex)) {
                    colors.push(hex);
                    sync();
                    render();
                }
            });

            render();
        })();

        // ── Image Upload ─────────────────────────────────────────────
        function handleImageUpload(input) {
            if (!input.files?.[0]) return;
            const reader = new FileReader();
            reader.onload = e => {
                document.getElementById('uploadPlaceholder').style.display      = 'none';
                document.getElementById('imagePreviewContainer').style.display  = 'block';
                document.getElementById('primaryImagePreview').src              = e.target.result;
                document.getElementById('uploadedFileName').textContent         = '✓ ' + input.files[0].name;
                document.getElementById('uploadArea').classList.add('upload-loaded');
            };
            reader.readAsDataURL(input.files[0]);
        }

        function handleDragOver(e)  { e.preventDefault(); document.getElementById('uploadArea').classList.add('drag-over'); }
        function handleDragLeave(e) { e.preventDefault(); document.getElementById('uploadArea').classList.remove('drag-over'); }
        function handleDrop(e) {
            e.preventDefault();
            document.getElementById('uploadArea').classList.remove('drag-over');
            const file = e.dataTransfer.files[0];
            if (file?.type.startsWith('image/')) {
                const dt = new DataTransfer();
                dt.items.add(file);
                const input = document.getElementById('imageFile');
                input.files = dt.files;
                handleImageUpload(input);
            }
        }

        // ── Size Multi-Select Dropdown ───────────────────────────────
        (function () {
            const hidden      = document.getElementById('sizeHidden');
            const items       = document.querySelectorAll('#sizeList .size-list-item');
            const triggerText = document.getElementById('sizeTriggerText');
            let selected      = hidden.value ? hidden.value.split(',').map(s => s.trim()).filter(Boolean) : [];

            function sync() {
                hidden.value        = selected.join(', ');
                triggerText.textContent = selected.length ? selected.join(', ') : 'Select Size';
            }

            items.forEach(item => {
                if (selected.includes(item.dataset.size)) item.classList.add('selected');
                item.addEventListener('click', () => {
                    const s = item.dataset.size;
                    if (selected.includes(s)) {
                        selected = selected.filter(x => x !== s);
                        item.classList.remove('selected');
                    } else {
                        selected.push(s);
                        item.classList.add('selected');
                    }
                    sync();
                });
            });

            document.addEventListener('click', e => {
                if (!document.getElementById('sizeDropdown').contains(e.target))
                    closeSizeDropdown();
            });

            sync();
        })();

        // ── Size Dropdown Toggle ─────────────────────────────────────
        function toggleSizeDropdown() {
            const open = document.getElementById('sizePanel').classList.contains('open');
            document.getElementById('sizePanel').classList.toggle('open', !open);
            document.getElementById('sizeChevron').classList.toggle('rotated', !open);
            document.getElementById('sizeTrigger').classList.toggle('active', !open);
        }
        function closeSizeDropdown() {
            document.getElementById('sizePanel').classList.remove('open');
            document.getElementById('sizeChevron').classList.remove('rotated');
            document.getElementById('sizeTrigger').classList.remove('active');
        }

        // ── Showcase Images — 6-slot grid ───────────────────────────
        const MAX_SHOWCASE    = 6;
        let showcaseFileList  = new Array(MAX_SHOWCASE).fill(null);
        let pendingSlot       = null;

        function findFirstEmpty() {
            return showcaseFileList.findIndex(f => f === null);
        }

        function triggerSlotPick(slotIdx) {
            if (slotIdx < 0 || slotIdx >= MAX_SHOWCASE) return;
            const slot = document.getElementById('scSlot' + slotIdx);
            if (slot?.classList.contains('filled')) return;
            pendingSlot = slotIdx;
            const input = document.getElementById('showcaseFiles');
            input.removeAttribute('multiple');
            input.onchange = function () { assignToSlot(this.files[0], pendingSlot); input.value = ''; };
            input.click();
        }

        function triggerSlotReplace(slotIdx) {
            pendingSlot = slotIdx;
            const input = document.getElementById('showcaseFiles');
            input.removeAttribute('multiple');
            input.onchange = function () { assignToSlot(this.files[0], pendingSlot); input.value = ''; };
            input.click();
        }

        function assignToSlot(file, idx) {
            if (!file || !file.type.startsWith('image/')) return;
            showcaseFileList[idx] = file;
            const reader = new FileReader();
            reader.onload = e => {
                const slot = document.getElementById('scSlot' + idx);
                slot.innerHTML = `
                    <img src="${e.target.result}" alt="" />
                    <button type="button" class="sc-slot-add-btn"
                            onclick="event.stopPropagation();triggerSlotReplace(${idx})" title="Change">
                        <i class="fa-solid fa-plus"></i>
                    </button>
                    <button type="button" class="sc-slot-rm"
                            onclick="event.stopPropagation();clearSlot(${idx})" title="Remove">✕</button>`;
                slot.classList.remove('empty');
                slot.classList.add('filled');
                slot.onclick = null;
                updateMainPreview();
                syncShowcaseInput();
            };
            reader.readAsDataURL(file);
        }

        function clearSlot(idx) {
            showcaseFileList[idx] = null;
            const slot = document.getElementById('scSlot' + idx);
            slot.innerHTML = '<i class="fa-solid fa-plus sc-slot-icon"></i>';
            slot.classList.remove('filled');
            slot.classList.add('empty');
            slot.onclick = () => triggerSlotPick(idx);
            updateMainPreview();
            syncShowcaseInput();
        }

        function updateMainPreview() {
            const firstFilled = document.querySelector('#showcaseGrid .sc-slot.filled img');
            const bigImg      = document.getElementById('scMainImg');
            const placeholder = document.getElementById('scMainPlaceholder');
            const mainPreview = document.getElementById('scMainPreview');

            if (firstFilled) {
                bigImg.src              = firstFilled.src;
                bigImg.style.display    = 'block';
                placeholder.style.display = 'none';
                mainPreview.onclick     = null;
                mainPreview.style.cursor = 'default';
            } else {
                bigImg.style.display      = 'none';
                placeholder.style.display = 'flex';
                mainPreview.onclick       = () => triggerSlotPick(findFirstEmpty());
                mainPreview.style.cursor  = 'pointer';
            }
        }

        function syncShowcaseInput() {
            const dt = new DataTransfer();
            showcaseFileList.forEach(f => { if (f) dt.items.add(f); });
            document.getElementById('showcaseFiles').files = dt.files;
        }
    </script>
}
