@model ConceptFactory.Models.Product
@using ConceptFactory.Models
@{
    ViewData["Title"] = Model.ProductName;
    ViewData["ActivePage"] = "Products";

    var sizes = string.IsNullOrEmpty(Model.Size)
        ? new List<string>()
        : Model.Size.Split(',').Select(s => s.Trim()).Where(s => s != "").ToList();

    var colors = string.IsNullOrEmpty(Model.Color)
        ? new List<string>()
        : Model.Color.Split(',').Select(s => s.Trim()).Where(s => s != "").ToList();

    var colorMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        {"red","#e53e3e"},{"blue","#3182ce"},{"black","#1a202c"},{"white","#f0f0f0"},
        {"green","#38a169"},{"yellow","#d69e2e"},{"orange","#dd6b20"},{"purple","#805ad5"},
        {"pink","#d53f8c"},{"brown","#744210"},{"gray","#718096"},{"grey","#718096"},
        {"navy","#1a365d"},{"maroon","#742a2a"},{"teal","#2c7a7b"},{"beige","#fef3c7"}
    };

    var services = ViewBag.Services as List<Service> ?? new List<Service>();

    var printLocations = new[]
    {
        new { Icon = "fa-shirt",           Label = "Front" },
        new { Icon = "fa-rotate-180 fa-shirt", Label = "Back" },
        new { Icon = "fa-shirt",           Label = "Left Chest" },
        new { Icon = "fa-shirt",           Label = "Right Chest" },
        new { Icon = "fa-shirt",           Label = "Left Sleeve" },
        new { Icon = "fa-shirt",           Label = "Right Sleeve" },
        new { Icon = "fa-shirt",           Label = "Front / Back" },
    };

    int step = 1;
}

<style>
/* ── page wrapper ── */
.pd-page {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 4px 40px;
}
.pd-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--store-text-sub);
    text-decoration: none;
    margin-bottom: 18px;
    transition: color .15s;
}
.pd-back:hover { color: var(--store-primary); }

/* ── two-column grid ── */
.pd-grid {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 28px;
    align-items: start;
}
@@media (max-width: 820px) { .pd-grid { grid-template-columns: 1fr; } }

/* ══════════════════════════════════════
   LEFT COLUMN — image
══════════════════════════════════════ */
.pd-img-card {
    background: #f4f5ff;
    border-radius: 16px;
    border: 1.5px solid #e2e8f0;
    overflow: hidden;
    position: relative;
}
.pd-img-main {
    aspect-ratio: 1/1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    position: relative;
}
.pd-img-main img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}
.pd-design-overlay {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    font-size: 13px;
    font-weight: 900;
    color: #7c86d4;
    text-align: center;
    line-height: 1.4;
    letter-spacing: 1px;
    pointer-events: none;
}
/* thumbnail strip */
.pd-thumbs {
    display: flex;
    gap: 8px;
    padding: 12px 14px;
    border-top: 1.5px solid #e2e8f0;
    background: #fff;
}
.pd-thumb {
    flex: 1;
    aspect-ratio: 1/1;
    border-radius: 9px;
    border: 1.5px solid #e2e8f0;
    background: #f4f5ff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #a5b4fc;
    font-size: 20px;
    transition: border-color .15s;
}
.pd-thumb:hover, .pd-thumb.active { border-color: var(--store-primary); }

/* ══════════════════════════════════════
   RIGHT COLUMN — info
══════════════════════════════════════ */
.pd-info {
    display: flex;
    flex-direction: column;
    gap: 0;
}
.pd-title {
    font-size: 20px;
    font-weight: 800;
    color: var(--store-text-main);
    margin-bottom: 2px;
}
.pd-price {
    font-size: 22px;
    font-weight: 800;
    color: var(--store-text-main);
    margin-bottom: 6px;
}
.pd-desc {
    font-size: 12.5px;
    color: var(--store-text-sub);
    line-height: 1.6;
    margin-bottom: 16px;
}

/* ── step block ── */
.pd-step {
    margin-bottom: 13px;
}
.pd-step-title {
    font-size: 12px;
    font-weight: 700;
    color: var(--store-text-main);
    margin-bottom: 7px;
}
.pd-step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px; height: 18px;
    background: var(--store-primary);
    color: #fff;
    border-radius: 50%;
    font-size: 10px;
    font-weight: 800;
    margin-right: 5px;
    flex-shrink: 0;
}

/* sizes */
.pd-size-row { display: flex; gap: 6px; flex-wrap: wrap; }
.pd-size {
    min-width: 36px;
    padding: 5px 9px;
    border-radius: 7px;
    border: 1.5px solid var(--store-border);
    font-size: 12px;
    font-weight: 700;
    color: var(--store-text-sub);
    background: #fff;
    cursor: pointer;
    text-align: center;
    transition: all .15s;
}
.pd-size:hover  { border-color: var(--store-primary); color: var(--store-primary); }
.pd-size.active { background: var(--store-primary); color: #fff; border-color: var(--store-primary); }

/* colors */
.pd-color-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
.pd-color {
    width: 26px; height: 26px;
    border-radius: 50%;
    cursor: pointer;
    border: 2.5px solid transparent;
    outline: 2px solid transparent;
    transition: outline-color .15s, transform .15s;
}
.pd-color:hover  { transform: scale(1.15); }
.pd-color.active { outline: 2.5px solid var(--store-primary); outline-offset: 2px; }

/* services – 4-up grid matching screenshot */
.pd-svc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 7px;
}
@@media (max-width: 500px) { .pd-svc-grid { grid-template-columns: repeat(2,1fr); } }

.pd-svc {
    border: 1.5px solid var(--store-border);
    border-radius: 9px;
    padding: 8px 8px 7px;
    cursor: pointer;
    transition: border-color .15s, background .15s;
    text-align: center;
}
.pd-svc:hover  { border-color: var(--store-primary); background: #fafbff; }
.pd-svc.active { border-color: var(--store-primary); background: #eef0ff; }
.pd-svc-name  { font-size: 11px; font-weight: 700; color: var(--store-text-main); line-height: 1.3; margin-bottom: 2px; }
.pd-svc-price { font-size: 11px; color: var(--store-primary); font-weight: 700; }
.pd-svc-desc  { font-size: 10px; color: var(--store-text-muted); line-height: 1.3; margin-top: 2px; }

/* print locations – icon grid matching screenshot */
.pd-loc-grid {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
}
.pd-loc {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: 7px 8px 5px;
    border: 1.5px solid var(--store-border);
    border-radius: 9px;
    cursor: pointer;
    font-size: 9.5px;
    font-weight: 600;
    color: var(--store-text-sub);
    background: #fff;
    min-width: 50px;
    transition: all .15s;
    text-align: center;
}
.pd-loc img, .pd-loc i {
    width: 28px; height: 28px;
    object-fit: contain;
    font-size: 20px;
    color: #a5b4fc;
}
.pd-loc:hover, .pd-loc.active {
    border-color: var(--store-primary);
    color: var(--store-primary);
    background: #eef0ff;
}
.pd-loc.active i { color: var(--store-primary); }
.pd-loc-text {
    width: 100%;
    margin-top: 7px;
    padding: 8px 11px;
    border: 1.5px solid var(--store-border);
    border-radius: 8px;
    font-size: 12px;
    font-family: inherit;
    color: var(--store-text-main);
    outline: none;
    transition: border-color .2s;
    resize: none;
}
.pd-loc-text:focus { border-color: var(--store-primary); box-shadow: 0 0 0 3px rgba(91,94,244,.08); }

/* upload */
.pd-upload {
    border: 2px dashed #c7caff;
    border-radius: 11px;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 14px;
    cursor: pointer;
    background: #fafbff;
    transition: border-color .2s, background .2s;
}
.pd-upload:hover { border-color: var(--store-primary); background: #eef0ff; }
.pd-upload-icon { font-size: 26px; color: #818cf8; flex-shrink: 0; }
.pd-upload-text strong { font-size: 12.5px; font-weight: 700; color: var(--store-text-main); display: block; }
.pd-upload-text small  { font-size: 11px; color: var(--store-text-muted); }
.pd-upload-browse { color: var(--store-primary); font-size: 11.5px; font-weight: 600; cursor: pointer; text-decoration: underline; display: inline-block; margin-top: 2px; }

/* uploaded file previews */
.pd-upload-previews { display: flex; gap: 7px; flex-wrap: wrap; margin-top: 8px; }
.pd-preview-thumb {
    position: relative;
    width: 52px; height: 52px;
    border-radius: 7px;
    overflow: hidden;
    border: 1.5px solid var(--store-border);
}
.pd-preview-thumb img { width: 100%; height: 100%; object-fit: cover; }
.pd-preview-rm {
    position: absolute; top: 1px; right: 1px;
    width: 15px; height: 15px;
    border-radius: 50%;
    background: rgba(229,62,62,.85);
    color: #fff; font-size: 8px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; border: none;
}

/* existing uploaded files row (from DB) */
.pd-existing-files { display: flex; gap: 7px; flex-wrap: wrap; margin-top: 6px; }
.pd-existing-file {
    display: flex; align-items: center; gap: 5px;
    padding: 4px 10px 4px 7px;
    border-radius: 20px;
    background: #eef0ff;
    border: 1px solid #c7caff;
    font-size: 11.5px;
    color: var(--store-primary);
    font-weight: 600;
}
.pd-existing-file i { font-size: 12px; }

/* quantity */
.pd-qty-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}
.pd-stepper {
    display: flex;
    align-items: center;
    border: 1.5px solid var(--store-border);
    border-radius: 8px;
    overflow: hidden;
}
.pd-stepper button {
    width: 34px; height: 34px;
    border: none;
    background: #f8f9fc;
    font-size: 18px;
    font-weight: 700;
    cursor: pointer;
    color: var(--store-text-main);
    font-family: inherit;
    transition: background .15s;
}
.pd-stepper button:hover { background: #e2e8f0; }
.pd-stepper span {
    min-width: 44px;
    text-align: center;
    font-size: 14px;
    font-weight: 700;
    height: 34px;
    line-height: 34px;
    border-left: 1.5px solid var(--store-border);
    border-right: 1.5px solid var(--store-border);
}
.pd-qty-badges { display: flex; gap: 6px; flex-wrap: wrap; }
.pd-qty-badge {
    padding: 4px 10px;
    border-radius: 6px;
    background: #f0f1ff;
    border: 1px solid #c7caff;
    font-size: 11px;
    font-weight: 700;
    color: var(--store-primary);
    cursor: pointer;
    transition: background .15s;
    line-height: 1.4;
}
.pd-qty-badge:hover { background: #e0e1ff; }
.pd-qty-badge small { display: block; font-size: 9.5px; font-weight: 500; color: var(--store-text-muted); }

/* divider */
.pd-divider { border: none; border-top: 1.5px solid var(--store-border); margin: 14px 0; }

/* CTA row */
.pd-cta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 4px;
}
.pd-btn-cart {
    padding: 12px;
    border: 2px solid var(--store-primary);
    border-radius: 10px;
    background: #fff;
    color: var(--store-primary);
    font-size: 13.5px;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    transition: background .15s, color .15s;
    display: flex; align-items: center; justify-content: center; gap: 7px;
}
.pd-btn-cart:hover { background: var(--store-primary); color: #fff; }
.pd-btn-checkout {
    padding: 12px;
    border: none;
    border-radius: 10px;
    background: var(--store-primary);
    color: #fff;
    font-size: 13.5px;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(91,94,244,.3);
    transition: background .15s;
    display: flex; align-items: center; justify-content: center; gap: 7px;
}
.pd-btn-checkout:hover { background: var(--store-primary-dark); }
</style>

<div class="pd-page">

    <a asp-controller="Store" asp-action="Browse" class="pd-back">
        <i class="fa-solid fa-arrow-left"></i>
    </a>

    <div class="pd-grid">

        <!-- ════════════════════════════
             LEFT — image
        ════════════════════════════ -->
        <div class="pd-img-card">
            <div class="pd-img-main">
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath" alt="@Model.ProductName" id="mainImg" />
                }
                else
                {
                    <img src="/images/mockups/@(GetMockup(Model.Category?.CategoryName)).svg"
                         alt="@Model.ProductName" id="mainImg"
                         style="width:80%; height:80%; object-fit:contain; opacity:.9;" />
                    <div class="pd-design-overlay">YOUR<br>DESIGN<br>HERE</div>
                }
            </div>
            <div class="pd-thumbs">
                @for (int i = 0; i < 4; i++)
                {
                    <div class="pd-thumb @(i == 0 ? "active" : "")">
                        <i class="fa-solid fa-shirt"></i>
                    </div>
                }
            </div>
        </div>

        <!-- ════════════════════════════
             RIGHT — info
        ════════════════════════════ -->
        <div class="pd-info">

            <div class="pd-title">@Model.ProductName</div>
            <div class="pd-price">₱@Model.Price.ToString("N2")</div>
            @if (!string.IsNullOrEmpty(Model.ProductDescription))
            {
                <p class="pd-desc">@Model.ProductDescription</p>
            }

            <!-- 1. Size -->
            @if (sizes.Any())
            {
                <div class="pd-step">
                    <div class="pd-step-title">
                        <span class="pd-step-num">@(step++)</span> Select Size
                    </div>
                    <div class="pd-size-row">
                        @foreach (var s in sizes)
                        {
                            <div class="pd-size" onclick="selectGroup(this,'pd-size')">@s</div>
                        }
                    </div>
                </div>
            }

            <!-- 2. Color -->
            @if (colors.Any())
            {
                <div class="pd-step">
                    <div class="pd-step-title">
                        <span class="pd-step-num">@(step++)</span> Choose Color
                    </div>
                    <div class="pd-color-row">
                        @foreach (var c in colors)
                        {
                            string hex = colorMap.ContainsKey(c) ? colorMap[c] : "#cccccc";
                            <div class="pd-color" title="@c" style="background:@hex;"
                                 onclick="selectGroup(this,'pd-color')"></div>
                        }
                    </div>
                </div>
            }

            <!-- 3. Printing Services -->
            @if (services.Any())
            {
                <div class="pd-step">
                    <div class="pd-step-title">
                        <span class="pd-step-num">@(step++)</span> Select Printing Services
                    </div>
                    <div class="pd-svc-grid">
                        @foreach (var svc in services)
                        {
                            <div class="pd-svc" onclick="selectSvc(this)">
                                <div class="pd-svc-name">@svc.ServiceName</div>
                                <div class="pd-svc-price">+₱@svc.ServicePrice.ToString("N2")</div>
                                <div class="pd-svc-desc">@svc.ServiceDescription</div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- 4. Print Location -->
            <div class="pd-step">
                <div class="pd-step-title">
                    <span class="pd-step-num">@(step++)</span> Print Location
                </div>
                <div class="pd-loc-grid">
                    @foreach (var loc in printLocations)
                    {
                        <div class="pd-loc" onclick="selectGroup(this,'pd-loc')">
                            <i class="fa-solid @loc.Icon"></i>
                            @loc.Label
                        </div>
                    }
                </div>
                <textarea class="pd-loc-text" rows="2"
                    placeholder="Specify your print location (e.g. Lower front, near the waist band, print both sides, etc.)"></textarea>
            </div>

            <!-- 5. Upload Your Design -->
            <div class="pd-step">
                <div class="pd-step-title">
                    <span class="pd-step-num">@(step++)</span> Upload Your Design
                </div>
                <div class="pd-upload" onclick="document.getElementById('designFiles').click()">
                    <i class="fa-solid fa-cloud-arrow-up pd-upload-icon"></i>
                    <div class="pd-upload-text">
                        <strong>Drag &amp; drop your files here</strong>
                        <small>PNG, JPG, SVG, PDF | Max 10MB</small>
                        <span class="pd-upload-browse">Browse Files</span>
                    </div>
                </div>
                <input type="file" id="designFiles" accept="image/*,.pdf,.svg" multiple
                       style="display:none;" onchange="handleFiles(this)" />
                <div class="pd-upload-previews" id="uploadPreviews"></div>
            </div>

            <!-- 6. Quantity -->
            <div class="pd-step">
                <div class="pd-step-title">
                    <span class="pd-step-num">@(step++)</span> Quantity
                </div>
                <div class="pd-qty-row">
                    <div class="pd-stepper">
                        <button type="button" onclick="changeQty(-1)">−</button>
                        <span id="qtyDisplay">10</span>
                        <button type="button" onclick="changeQty(1)">+</button>
                    </div>
                    <div class="pd-qty-badges">
                        <div class="pd-qty-badge" onclick="setQty(20)">
                            20 pcs
                            <small>5% OFF</small>
                        </div>
                        <div class="pd-qty-badge" onclick="setQty(50)">
                            50 pcs
                            <small>10% OFF</small>
                        </div>
                        <div class="pd-qty-badge" onclick="setQty(100)">
                            100 pcs
                            <small>15% OFF</small>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="pd-divider" />

            <!-- CTA -->
            <div class="pd-cta">
                <a href="#" class="pd-btn-cart">
                    <i class="fa-solid fa-cart-plus"></i> Add to Cart
                </a>
                <a href="#" class="pd-btn-checkout">
                    Check Out
                </a>
            </div>

        </div><!-- /pd-info -->
    </div><!-- /pd-grid -->
</div>

@section Scripts {
<script>
    const unitPrice = @Model.Price;
    let qty = 10;
    let svcPrice = 0;

    function changeQty(d) { setQty(Math.max(1, qty + d)); }

    function setQty(n) {
        qty = n;
        document.getElementById('qtyDisplay').textContent = qty;
    }

    function selectGroup(el, cls) {
        el.closest('.' + cls + '-row, .pd-size-row, .pd-color-row, .pd-loc-grid')
          .querySelectorAll('.' + cls)
          .forEach(c => c.classList.remove('active'));
        el.classList.add('active');
    }

    function selectSvc(el) {
        const wasActive = el.classList.contains('active');
        document.querySelectorAll('.pd-svc').forEach(c => c.classList.remove('active'));
        if (!wasActive) {
            el.classList.add('active');
            const txt = el.querySelector('.pd-svc-price')?.textContent || '';
            svcPrice = parseFloat(txt.replace(/[^\d.]/g, '')) || 0;
        } else {
            svcPrice = 0;
        }
    }

    function handleFiles(input) {
        const wrap = document.getElementById('uploadPreviews');
        wrap.innerHTML = '';
        Array.from(input.files).forEach(file => {
            if (!file.type.startsWith('image/')) return;
            const reader = new FileReader();
            reader.onload = e => {
                const div = document.createElement('div');
                div.className = 'pd-preview-thumb';
                div.innerHTML = `<img src="${e.target.result}"/><button class="pd-preview-rm" onclick="this.parentElement.remove()">✕</button>`;
                wrap.appendChild(div);
            };
            reader.readAsDataURL(file);
        });
    }
</script>
}

@functions {
    string GetMockup(string? cat)
    {
        if (string.IsNullOrEmpty(cat)) return "tshirt";
        var n = cat.ToLower();
        if (n.Contains("hoodie"))                    return "hoodie";
        if (n.Contains("polo"))                      return "polo";
        if (n.Contains("tote") || n.Contains("bag")) return "totebag";
        return "tshirt";
    }
}
