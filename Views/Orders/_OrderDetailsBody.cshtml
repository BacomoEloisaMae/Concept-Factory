@model ConceptFactory.Models.Order
@using ConceptFactory.Models
@{
    string[] stages = { "Cutting", "Printing", "Sewing", "Trimming", "Quality Check"};
    bool canEdit = Model.Status == "Pending Down Payment" || Model.Status == "Pending Cash Payment"
                || Model.Status == "Pending Payment Verification" || Model.Status == "Confirmed";
    bool canCancel = canEdit;
}
<div class="od-top-grid">
    <!-- Customer Information -->
    <div class="od-card">
        <div class="od-card-title"><i class="fa-regular fa-id-card"></i> Customer Information</div>
        <div class="od-customer-row">
            <div class="od-avatar"><i class="fa-solid fa-user"></i></div>
            <div>
                <div class="od-customer-name">@Model.CustomerName</div>
                <div class="od-customer-sub">@(string.IsNullOrEmpty(Model.CustomerEmail) ? "—" : Model.CustomerEmail)</div>
                <div class="od-customer-sub">@(string.IsNullOrEmpty(Model.CustomerPhone) ? "—" : Model.CustomerPhone)</div>
                <div class="od-customer-sub">@(string.IsNullOrEmpty(Model.CustomerAddress) ? "—" : Model.CustomerAddress)</div>
            </div>
        </div>
    </div>

    <!-- Order Information -->
    <div class="od-card">
        <div class="od-card-title"><i class="fa-regular fa-clipboard"></i> Order Information</div>
        <div class="od-info-grid">
            <div class="od-info-row"><label>Order Date</label><span>@Model.OrderDate.ToString("MMMM d, yyyy h:mm tt")</span></div>
            <div class="od-info-row">
                <label>Order Status</label>
                <span class="status-badge @OrderStatusDisplay.BadgeClass(Model.Status)">
                    @Model.Status
                </span>
            </div>
            <div class="od-info-row"><label>Payment ID</label><span title="Same number as this Order ID, just prefixed PAY- instead of ORD-">#@Model.PaymentID</span></div>
            <div class="od-info-row">
                <label>Payment Status</label>
                <span class="status-badge @OrderStatusDisplay.PaymentBadgeClass(Model.PaymentStatus)">
                    @Model.PaymentStatus
                </span>
            </div>
            <div class="od-info-row"><label>Payment Method</label><span>@(Model.PaymentMethod ?? "—")</span></div>
            @if (Model.PaymentMethod == "Gcash" && !string.IsNullOrEmpty(Model.ReferenceNumber))
            {
                <div class="od-info-row"><label>Reference Number</label><span>#@Model.ReferenceNumber</span></div>
            }
        </div>
    </div>
</div>

<!-- Product Details -->
<div class="od-card">
    <div class="od-card-title"><i class="fa-solid fa-shirt"></i> Product Details</div>
    @foreach (var d in Model.OrderDetails)
    {
        var name = !string.IsNullOrEmpty(d.ProductNameSnapshot) ? d.ProductNameSnapshot : (d.Product != null ? d.Product.ProductName : "Item");
        var imgPath = !string.IsNullOrEmpty(d.ImageSnapshotPath) ? d.ImageSnapshotPath : (d.Product != null ? d.Product.ImagePath : null);
        // UnitPrice is stored as product + service combined (see
        // HomeController.ProcessSubmitOrder), so the service portion is
        // split back out here for display using the stored snapshot price,
        // rather than only showing one opaque combined number.
        var lineServiceFee = d.ServicePriceSnapshot ?? 0;
        var lineProductPrice = d.UnitPrice - lineServiceFee;
        <div class="od-product-row">
            <div class="od-product-thumb">
                @if (!string.IsNullOrEmpty(imgPath))
                {
                    <img src="@imgPath" alt="@name" />
                }
                else
                {
                    <i class="fa-solid fa-shirt"></i>
                }
            </div>
            <div class="od-product-info">
                <div class="od-product-name">@d.Quantity x @name</div>
                @if (!string.IsNullOrEmpty(d.SelectedColor)) { <div class="od-product-attr">Color: <strong>@d.SelectedColor</strong></div> }
                @if (!string.IsNullOrEmpty(d.SelectedSize)) { <div class="od-product-attr">Size: <strong>@d.SelectedSize</strong></div> }
                @if (!string.IsNullOrEmpty(d.ServiceNameSnapshot)) { <div class="od-product-attr">Printing Method: <strong>@d.ServiceNameSnapshot</strong></div> }
                @if (!string.IsNullOrEmpty(d.PrintLocation)) { <div class="od-product-attr">Print Location: <strong>@d.PrintLocation</strong></div> }

                <div class="od-product-attr">
                    Quantity: <strong>@d.Quantity </strong>
				</div>
                @if (!string.IsNullOrEmpty(d.DesignNotes)) { <div class="od-product-attr">Custom Note: @d.DesignNotes</div> }
            </div>
            <div class="od-product-prices">
                <div class="od-product-attr">Product Price</div>
                <div class="od-product-price-val">₱@lineProductPrice.ToString("N2")</div>
                @if (lineServiceFee > 0)
                {
                    <div class="od-product-attr od-attr-spaced">Service Fee</div>
                    <div class="od-product-price-val">₱@lineServiceFee.ToString("N2")</div>
                }
                <div class="od-product-attr od-attr-spaced">Total Amount</div>
                <div class="od-product-price-val">₱@((d.UnitPrice * d.Quantity).ToString("N2"))</div>
            </div>
        </div>
    }
</div>

<div class="od-bottom-grid">
    <!-- Uploaded Design -->
    <div class="od-card">
        <div class="od-card-title"><i class="fa-regular fa-image"></i> Uploaded Design</div>
        @{ var linesWithDesign = Model.OrderDetails.Where(d => !string.IsNullOrEmpty(d.DesignFilePath)).ToList(); }
        @if (linesWithDesign.Any())
        {
            @foreach (var d in linesWithDesign)
            {
                var fileName = System.IO.Path.GetFileName(d.DesignFilePath);
                <div class="od-design-row">
                    <div class="od-design-thumb"><img src="@d.DesignFilePath" alt="Uploaded design" /></div>
                    <div class="od-design-info">
                        <div class="od-design-name">@fileName</div>
                        <div class="od-design-actions">
                            <a href="@d.DesignFilePath" target="_blank" class="od-design-link"><i class="fa-solid fa-magnifying-glass"></i> Preview</a>
                            <a href="@d.DesignFilePath" download class="od-design-link"><i class="fa-solid fa-download"></i> Download</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="od-design-empty"><i class="fa-regular fa-image"></i><p>No design file was uploaded for this order.</p></div>
        }
    </div>

    <!-- Payment Summary (Read Only) -->
    @{
        var totalServiceFees = Model.OrderDetails.Sum(d => (d.ServicePriceSnapshot ?? 0) * d.Quantity);
        var totalProductPrice = Model.TotalAmount - totalServiceFees;
    }
    <div class="od-card">
        <div class="od-card-title"><i class="fa-solid fa-wallet"></i> Payment Summary <span class="od-readonly-tag">Read Only</span></div>
        <div class="od-total-row"><span>Product Price</span><span>₱@totalProductPrice.ToString("N2")</span></div>
        @if (totalServiceFees > 0)
        {
            <div class="od-total-row"><span>Service Fees</span><span>₱@totalServiceFees.ToString("N2")</span></div>
        }
        <div class="od-total-row od-total-row-highlight payment-required"><span>Total Amount</span><span>₱@Model.TotalAmount.ToString("N2")</span></div>
        <div class="od-total-row od-total-row-highlight payment-paid"><span>Down Payment Paid</span><span>₱@Model.DownPaymentAmount.ToString("N2") @(Model.TotalAmount > 0 ? $"({Math.Round(Model.DownPaymentAmount / Model.TotalAmount * 100, 1)}%)" : "")</span></div>
        <div class="od-total-row od-total-final od-total-row-highlight"><span>Remaining Balance</span><span class="@(Model.RemainingBalance <= 0 ? "od-remaining-cleared" : "")">₱@Model.RemainingBalance.ToString("N2")</span></div>
    </div>
</div>

<!-- Production Progress (Read Only) -->
<div class="od-card">
    <div class="od-card-title"><i class="fa-solid fa-industry"></i> Production Progress <span class="od-readonly-tag">Read Only</span></div>
    @if (Model.Status == "Cancelled")
    {
        <div class="od-cancelled-note"><i class="fa-solid fa-circle-xmark"></i> This order was cancelled — production is not tracked.</div>
    }
    else if (Model.Status == "Pending Down Payment" || Model.Status == "Pending Cash Payment" || Model.Status == "Pending Payment Verification")
    {
        <div class="od-cancelled-note"><i class="fa-solid fa-hourglass-half"></i> Waiting for the down payment to be confirmed in Billing before production can begin.</div>
    }
    else
    {
        @if (Model.Status == "Confirmed")
        {
            <div class="od-cancelled-note">
                <i class="fa-solid fa-clock"></i>
                Waiting to Start Production.
            </div>
        }
        else
        {
            <div class="od-stepper od-stepper-readonly">
                @for (int i = 0; i < stages.Length; i++)
                {
                    bool done = i <= Model.ProductionStage;
                    bool current = i == Model.ProductionStage;

                    <div class="od-stepper-step @(done ? "done" : "") @(current ? "current" : "")">
                        <span class="od-stepper-dot">@(done ? "✓" : (i + 1).ToString())</span>
                        <span class="od-stepper-label">@stages[i]</span>
                    </div>

                    @if (i < stages.Length - 1)
                    {
                        <div class="od-stepper-line @(i < Model.ProductionStage ? "done" : "")"></div>
                    }
                }
            </div>
        }
    }

</div>

<!-- Actions -->
<div class="od-actions-row">
    @* <button type="button" class="btn btn-outline" onclick="window.print()">
        <i class="fa-solid fa-print"></i> Print Job Order
    </button> *@
    @if (canEdit)
    {
        <a asp-action="oEdit" asp-route-id="@Model.OrderID" class="btn btn-outline">
            <i class="fa-solid fa-pen"></i> Edit Order Details
        </a>
    }
    @if (canCancel)
    {
        <form asp-action="oUpdateStatus" method="post" class="od-inline-form" data-order-form="1" data-confirm="Cancel order #ORD-@Model.OrderID.ToString("D5")? This cannot be undone.">
            <input type="hidden" name="id" value="@Model.OrderID" />
            <input type="hidden" name="status" value="Cancelled" />
            <button type="submit" class="btn bvp-btn-reject">
                <i class="fa-solid fa-ban"></i> Cancel Order
            </button>
        </form>
    }
</div>
