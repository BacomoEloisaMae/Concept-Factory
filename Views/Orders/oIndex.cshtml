@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Orders";
    ViewData["ActivePage"] = "Orders";

    // ── UI-ONLY dummy data — no backend/DB wiring yet ──
    var orders = new[]
    {
        new { Id = "#ORD-00111", Customer = "Jorie Tecson", Products = "15x T-shirt<br>10x T-shirt", Amount = "₱2,500.00", Payment = "Paid", Status = "In Production", Date = "July 7, 2026", Time = "11:45 AM" },
        new { Id = "#ORD-00112", Customer = "Jorie Tecson", Products = "15x T-shirt<br>10x T-shirt", Amount = "₱2,500.00", Payment = "Paid", Status = "In Production", Date = "July 7, 2026", Time = "11:45 AM" },
        new { Id = "#ORD-00113", Customer = "Jorie Tecson", Products = "15x T-shirt<br>10x T-shirt", Amount = "₱2,500.00", Payment = "Paid", Status = "In Production", Date = "July 7, 2026", Time = "11:45 AM" },
    };
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin/orders.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
}
<div class="page-container">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">Order Management</h1>
            <p class="page-subtitle">View and Manage all customer orders</p>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="stat-cards-row">
        <div class="stat-card">
            <span class="stat-card-label">Total Orders</span>
            <div class="stat-card-body">
                <div class="stat-icon stat-icon-purple"><i class="fa-solid fa-bag-shopping"></i></div>
                <span class="stat-value">45</span>
            </div>
        </div>
        <div class="stat-card">
            <span class="stat-card-label">Completed</span>
            <div class="stat-card-body">
                <div class="stat-icon stat-icon-green"><i class="fa-solid fa-circle-check"></i></div>
                <span class="stat-value">45</span>
            </div>
        </div>
        <div class="stat-card">
            <span class="stat-card-label">In Production</span>
            <div class="stat-card-body">
                <div class="stat-icon stat-icon-orange"><i class="fa-solid fa-gear"></i></div>
                <span class="stat-value">56</span>
            </div>
        </div>
        <div class="stat-card">
            <span class="stat-card-label">Processing</span>
            <div class="stat-card-body">
                <div class="stat-icon stat-icon-blue"><i class="fa-solid fa-arrows-rotate"></i></div>
                <span class="stat-value">45</span>
            </div>
        </div>
        <div class="stat-card">
            <span class="stat-card-label">Cancelled</span>
            <div class="stat-card-body">
                <div class="stat-icon stat-icon-red"><i class="fa-solid fa-circle-xmark"></i></div>
                <span class="stat-value">10</span>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card">

        <!-- Tabs -->
        <div class="order-tabs">
            <a href="#" class="order-tab active">All Orders</a>
            <a href="#" class="order-tab">Processing</a>
            <a href="#" class="order-tab">In Production</a>
            <a href="#" class="order-tab">Completed</a>
            <a href="#" class="order-tab">Cancel</a>
        </div>

        <!-- Filters -->
        <div class="filter-bar">
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Search Products..." class="search-input" />
            </div>
            <select class="filter-select">
                <option>All Status</option>
                <option>Paid</option>
                <option>Unpaid</option>
            </select>
            <input type="text" placeholder="" class="filter-select" style="min-width:180px;" />
            <button type="button" class="btn btn-outline">
                <i class="fa-solid fa-filter"></i> Filter
            </button>
        </div>

        <!-- Orders Table -->
        <table class="data-table">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Products</th>
                    <th>Total Amount</th>
                    <th>Payment</th>
                    <th>Status</th>
                    <th>Order Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in orders)
                {
                    <tr>
                        <td><a href="#" class="order-id-link">@o.Id</a></td>
                        <td>@o.Customer</td>
                        <td class="order-products-cell">@Html.Raw(o.Products)</td>
                        <td>@o.Amount</td>
                        <td>
                            <span class="status-badge status-paid"><i class="fa-solid fa-circle-check"></i>@o.Payment</span>
                        </td>
                        <td>
                            <span class="status-badge status-inproduction"><i class="fa-solid fa-gear"></i>@o.Status</span>
                        </td>
                        <td class="order-date-cell">
                            @o.Date
                            <span class="order-time">@o.Time</span>
                        </td>
                        <td>
                            <div class="action-btn">
                                <a href="#" class="btn-icon" title="View">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <button type="button" class="btn-icon" title="More">
                                    <i class="fa-solid fa-ellipsis-vertical"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Pagination -->
        <div class="pagination">
            <span class="page-info">Showing 1–12 of 20 products</span>
            <div class="page-btns">
                <a href="#" class="page-btn">‹</a>
                <a href="#" class="page-btn active">1</a>
                <a href="#" class="page-btn">2</a>
                <a href="#" class="page-btn">3</a>
                <a href="#" class="page-btn">4</a>
                <a href="#" class="page-btn">›</a>
            </div>
        </div>
    </div>
</div>
