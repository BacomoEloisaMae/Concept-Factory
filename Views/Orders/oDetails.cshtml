@model ConceptFactory.Models.Order
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = $"Order #{Model.OrderID}";
    ViewData["ActivePage"] = "Orders";
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin/orders.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/billing.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
}
<div class="page-container">

    <a asp-action="oIndex" class="od-back-link"><i class="fa-solid fa-arrow-left"></i> Back to Orders</a>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="od-details-card">
        <div class="page-header od-header-spaced">
            <h1 class="page-title">Order Details</h1>
            <p class="page-subtitle">#ORD-@Model.OrderID.ToString("D3")</p>
        </div>

        @await Html.PartialAsync("_OrderDetailsBody", Model)
    </div>
</div>
