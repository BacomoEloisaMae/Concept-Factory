@model ConceptFactory.Models.Order
@using ConceptFactory.Models

@{
    // Real production order (matches ProductionStage 0-5 everywhere else
    // in the app — ProductionController, ProductionWorkflow). "Order
    // Confirm" is a virtual step 0 shown before any real station, purely
    // for this customer-facing stepper; it isn't a ProductionStage value.
    string[] stages = { "Cutting", "Printing", "Sewing", "Trimming", "Quality Check", "Ready for Pickup" };
    string[] stageIcons = { "fa-scissors", "fa-print", "fa-shirt", "fa-crop-simple", "fa-magnifying-glass", "fa-box" };

    string StatusBadgeClass(string status) => status switch
    {
        "Pending Down Payment" => "cot-badge-gray",
        "Pending Cash Payment" => "cot-badge-orange",
        "Pending Payment Verification" => "cot-badge-orange",
        "Confirmed" => "cot-badge-purple",
        "Design Review" => "cot-badge-blue",
        "In Production" => "cot-badge-orange",
        "Ready for Pickup" => "cot-badge-teal",
        "Completed" => "cot-badge-green",
        "Cancelled" => "cot-badge-red",
        _ => "cot-badge-gray"
    };

    string PaymentBadgeClass(string status) => status switch
    {
        "Partially Paid" => "cot-badge-purple",
        "Fully Paid" => "cot-badge-green",
        "Rejected" => "cot-badge-red",
        _ => "cot-badge-orange"
    };

    bool isCancelled = Model.Status == "Cancelled";

    bool isPending =
        Model.Status == "Pending Down Payment" ||
        Model.Status == "Pending Cash Payment" ||
        Model.Status == "Pending Payment Verification";

    bool canCancel =
        isPending ||
        Model.Status == "Confirmed" ||
        Model.Status == "Design Review";

    int totalQty = Model.OrderDetails.Sum(d => d.Quantity);

    var firstItemName = Model.OrderDetails
        .Select(d =>
            !string.IsNullOrEmpty(d.ProductNameSnapshot)
                ? d.ProductNameSnapshot
                : (d.Product != null ? d.Product.ProductName : "Item"))
        .FirstOrDefault() ?? "—";

    string productSummary =
        Model.OrderDetails.Count > 1
            ? $"{firstItemName} +{Model.OrderDetails.Count - 1} more"
            : firstItemName;

    // Pulled out of the markup below on purpose: nested quotes inside a
    // double-quoted HTML attribute (title="@string.Join(", ", ...)") can
    // throw off the Razor parser, so it's computed here and referenced
    // as a plain variable instead.
    string productNamesJoined = string.Join(
        ", ",
        Model.OrderDetails.Select(d => d.ProductNameSnapshot));

    // "Order Timeline" list below — same ActivityLogs the admin Overview
    // popup uses (see HomeController.hOrderDetailsPanel), just worded
    // for a customer instead of staff.
    List<ActivityLog> timelineLogs =
        ViewBag.TimelineLogs ?? new List<ActivityLog>();

    DateTime? orderConfirmedDate =
        timelineLogs
            .Where(l => l.Category == "Billing")
            .Select(l => (DateTime?)l.Timestamp)
            .FirstOrDefault();

    DateTime? StationDate(string stationName) =>
        timelineLogs
            .Where(l =>
                l.Category == "Production" &&
                l.Action == "Completed Station" &&
                (l.Details ?? "").Contains(stationName))
            .Select(l => (DateTime?)l.Timestamp)
            .FirstOrDefault();

    DateTime? pickedUpDate =
        timelineLogs
            .Where(l => l.Action == "Marked Order Completed")
            .Select(l => (DateTime?)l.Timestamp)
            .FirstOrDefault();
}

<div class="cot-card-header">
    <div>
        <div class="cot-card-title">
            Order #ORD-@Model.OrderID.ToString("D5")
            <span class="cot-badge @StatusBadgeClass(Model.Status)">
                @Model.Status
            </span>
        </div>

        <div class="cot-card-subtitle">
            Placed on @Model.OrderDate.ToString("MMMM d, yyyy | h:mm tt")
        </div>
    </div>
</div>

<div class="cot-infobar">
    <div class="cot-infobar-item">
        <label>Customer</label>
        <span>@Model.CustomerName</span>
    </div>

    <div class="cot-infobar-item">
        <label>Product</label>
        <span title="@productNamesJoined">@productSummary</span>
    </div>

    <div class="cot-infobar-item">
        <label>Quantity</label>
        <span>@totalQty pcs</span>
    </div>

    <div class="cot-infobar-item">
        <label>Total Amount</label>
        <span>₱@Model.TotalAmount.ToString("N2")</span>
    </div>

    <div class="cot-infobar-item">
        <label>Payment Status</label>
        <span class="cot-badge @PaymentBadgeClass(Model.PaymentStatus)">
            @Model.PaymentStatus
        </span>
    </div>
</div>

<div class="cot-card cot-progress-card">
    <div class="cot-section-title">
        <i class="fa-solid fa-industry"></i>
        Production Progress
    </div>

    @if (isCancelled)
    {
        <div class="cot-note-banner cot-note-danger">
            <i class="fa-solid fa-circle-xmark"></i>
            This order was cancelled.
        </div>
    }
    else
    {
        <div class="cot-icon-stepper">

            @{
                bool step0Done = !isPending;
                bool step0Current = isPending;

                string step0Class =
                step0Done
                ? "done"
                : (step0Current ? "current" : "");

                string step0Icon =
                step0Done
                ? "fa-check"
                : "fa-file-circle-check";

                string step0Sub =
                step0Done
                ? (orderConfirmedDate.HasValue
                ? orderConfirmedDate.Value.ToString("MMM d, yyyy")
                : "Confirmed")
                : "Waiting";
            }

            <div class="cot-icon-step @step0Class">
                <div class="cot-icon-step-dot">
                    <i class="fa-solid @step0Icon"></i>
                </div>

                <div class="cot-icon-step-label">
                    Order Confirm
                </div>

                <div class="cot-icon-step-sub">
                    @step0Sub
                </div>
            </div>

            @for (int i = 0; i < stages.Length; i++)
            {
                bool done =
                !isPending &&
                Model.Status != "Confirmed" &&
                Model.Status != "Design Review" &&
                i <= Model.ProductionStage &&
                !(i == 5 && Model.Status == "Ready for Pickup");

                bool current =
                !done &&
                !isPending &&
                (Model.Status == "In Production" ||
                Model.Status == "Ready for Pickup") &&
                i == Model.ProductionStage;

                bool prevDone =
                i == 0
                ? step0Done
                : (
                !isPending &&
                Model.Status != "Confirmed" &&
                Model.Status != "Design Review" &&
                (i - 1) <= Model.ProductionStage &&
                !(
                (i - 1) == 5 &&
                Model.Status == "Ready for Pickup"
                )
                );

                string lineClass = prevDone ? "done" : "";

                string stepClass =
                done
                ? "done"
                : (current ? "current" : "");

                string iconClass =
                done
                ? "fa-check"
                : stageIcons[i];

                string subLabel;

                if (done)
                {
                    DateTime? stationDoneDate =
                    (stages[i] == "Ready for Pickup" &&
                    Model.Status == "Completed")
                    ? pickedUpDate
                    : StationDate(stages[i]);

                    subLabel =
                    stationDoneDate.HasValue
                    ? stationDoneDate.Value.ToString("MMM d, yyyy")
                    : "Completed";
                }
                else if (current)
                {
                    subLabel =
                    stages[i] == "Ready for Pickup"
                    ? "Ready Now"
                    : "In Progress";
                }
                else
                {
                    subLabel = "Waiting";
                }

                <div class="cot-icon-step-line @lineClass"></div>

                <div class="cot-icon-step @stepClass">
                    <div class="cot-icon-step-dot">
                        <i class="fa-solid @iconClass"></i>
                    </div>

                    <div class="cot-icon-step-label">
                        @stages[i]
                    </div>

                    <div class="cot-icon-step-sub">
                        @subLabel
                    </div>
                </div>
            }
        </div>

        /*
        * IMPORTANT:
        * We are already inside the Razor `else { }` code block here.
        * Therefore, do NOT use `@{ }`.
        */

        string currStageName = stages[Model.ProductionStage];

        string prevStageName =
        Model.ProductionStage > 0
        ? stages[Model.ProductionStage - 1]
        : "";

        string bannerText =
        isPending
        ? "Waiting for your down payment to be confirmed before production begins."
        : Model.Status == "Confirmed" ||
        Model.Status == "Design Review"
        ? "Your order has been confirmed! Production will begin shortly."
        : Model.Status == "In Production"
        ? (
        Model.ProductionStage > 0
        ? $"{prevStageName} completed successfully! Your order has moved to {currStageName} Station."
        : $"Your order has moved to {currStageName} Station."
        )
        : Model.Status == "Ready for Pickup"
        ? "Your order is ready! Please visit the shop to pick it up."
        : Model.Status == "Completed"
        ? "This order has been completed. Thank you for choosing The Concept Factory!"
        : "";

        @if (!string.IsNullOrEmpty(bannerText))
        {
            <div class="cot-note-banner cot-note-info">
                <i class="fa-solid fa-circle-info"></i>
                @bannerText
            </div>
        }
    }
</div>

<div class="cot-bottom-grid">

    <div class="cot-card">

        <div class="cot-section-title">
            <i class="fa-solid fa-clock-rotate-left"></i>
            Order Timeline
        </div>

        @if (timelineLogs.Any())
        {
            <div class="cot-timeline">

                @foreach (var log in timelineLogs)
                {
                    <div class="cot-timeline-item">

                        <div class="cot-timeline-marker">
                            <i class="fa-solid fa-check"></i>
                        </div>

                        <div class="cot-timeline-content">

                            <div class="cot-timeline-row">

                                <span class="cot-timeline-title">
                                    @log.Action
                                </span>

                                <span class="cot-timeline-date">
                                    @log.Timestamp.ToString("MMM d, yyyy | h:mm tt")
                                </span>

                            </div>

                            @if (!string.IsNullOrEmpty(log.Details))
                            {
                                <div class="cot-timeline-desc">
                                    @log.Details
                                </div>
                            }

                        </div>
                    </div>
                }

            </div>
        }
        else
        {
            <div class="cot-empty-note">
                No updates yet.
            </div>
        }

    </div>

    <div class="cot-card">

        <div class="cot-section-title">
            <i class="fa-solid fa-receipt"></i>
            Order Summary
        </div>

        @{
            var totalServiceFees =
            Model.OrderDetails.Sum(
            d => (d.ServicePriceSnapshot ?? 0) * d.Quantity);

            var totalProductPrice =
            Model.TotalAmount - totalServiceFees;
        }

        @foreach (var d in Model.OrderDetails)
        {
            var name =
            !string.IsNullOrEmpty(d.ProductNameSnapshot)
            ? d.ProductNameSnapshot
            : (d.Product != null
            ? d.Product.ProductName
            : "Item");

            var imgPath =
            !string.IsNullOrEmpty(d.ImageSnapshotPath)
            ? d.ImageSnapshotPath
            : (d.Product != null
            ? d.Product.ImagePath
            : null);

            var lineServiceFee =
            d.ServicePriceSnapshot ?? 0;

            var lineProductPrice =
            d.UnitPrice - lineServiceFee;

            <div class="cot-product-row">

                <div class="cot-product-thumb">

                    @if (!string.IsNullOrEmpty(imgPath))
                    {
                        <img src="@imgPath" alt="@name" />
                    }
                    else
                    {
                        <i class="fa-solid fa-shirt"></i>
                    }

                </div>

                <div class="cot-product-info">

                    <div class="cot-product-name">
                        @d.Quantity x @name
                    </div>

                    @if (!string.IsNullOrEmpty(d.SelectedColor))
                    {
                        <div class="cot-product-attr">
                            Color:
                            <strong>@d.SelectedColor</strong>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(d.SelectedSize))
                    {
                        <div class="cot-product-attr">
                            Size:
                            <strong>@d.SelectedSize</strong>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(d.ServiceNameSnapshot))
                    {
                        <div class="cot-product-attr">
                            Printing:
                            <strong>@d.ServiceNameSnapshot</strong>
                        </div>
                    }

                </div>

                <div class="cot-product-price-col">

                    <div class="cot-product-price">
                        ₱@((lineProductPrice * d.Quantity).ToString("N2"))
                    </div>

                    @if (lineServiceFee > 0)
                    {
                        <div class="cot-product-attr cot-product-attr-spaced">
                            + ₱@((lineServiceFee * d.Quantity).ToString("N2")) fee
                        </div>
                    }

                </div>

            </div>
        }

        <div class="cot-total-row">
            <span>Subtotal</span>
            <span>₱@totalProductPrice.ToString("N2")</span>
        </div>

        @if (totalServiceFees > 0)
        {
            <div class="cot-total-row">
                <span>Service Fees</span>
                <span>₱@totalServiceFees.ToString("N2")</span>
            </div>
        }

        <div class="cot-total-row">
            <span>Down Payment Paid</span>
            <span>₱@Model.DownPaymentAmount.ToString("N2")</span>
        </div>

        <div class="cot-total-row cot-total-final">
            <span>Remaining Balance</span>

            <span class="@(Model.RemainingBalance <= 0 ? "cot-balance-cleared" : "")">
                ₱@Model.RemainingBalance.ToString("N2")
            </span>
        </div>

        <div class="cot-summary-divider"></div>

        <div class="cot-info-row">
            <label>Payment Method</label>
            <span>@(Model.PaymentMethod ?? "—")</span>
        </div>

        @if (Model.PaymentMethod == "Gcash" &&
                !string.IsNullOrEmpty(Model.ReferenceNumber))
        {
            <div class="cot-info-row">
                <label>Transaction Ref</label>
                <span>#@Model.ReferenceNumber</span>
            </div>
        }

        <div class="cot-info-row">
            <label>Payment Date</label>
            <span>
                @Model.OrderDate.ToString("MMM d, yyyy | h:mm tt")
            </span>
        </div>

        @{
            var linesWithDesign =
            Model.OrderDetails
            .Where(d => !string.IsNullOrEmpty(d.ImageSnapshotPath))
            .ToList();
        }

        @if (linesWithDesign.Any())
        {
            <div class="cot-summary-divider"></div>

            <div class="cot-uploaded-design-label">
                <i class="fa-regular fa-image"></i>
                Uploaded Design
            </div>

            @foreach (var d in linesWithDesign)
            {
                <div class="cot-design-row">

                    <div class="cot-design-thumb">
                        <img src="@d.ImageSnapshotPath"
                             alt="Uploaded design" />
                    </div>

                    <div class="cot-design-name">
                        @System.IO.Path.GetFileName(d.ImageSnapshotPath)
                    </div>

                </div>
            }
        }

    </div>

</div>

@if (canCancel)
{
    <div class="cot-actions-row">

        <button type="button"
                class="cot-cancel-btn"
                onclick="cfCancelMyOrder(@Model.OrderID)">

            <i class="fa-solid fa-ban"></i>
            Cancel Order

        </button>

    </div>
}