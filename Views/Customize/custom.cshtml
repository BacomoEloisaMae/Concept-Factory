@model ConceptFactory.Models.ViewModels.CustomOrderViewModel
@using ConceptFactory.Models
@{
    // This page represents a CUSTOM ORDER for a whole category, not one specific
    // product — sizes are always the full standard set, and the page
    var sizes = new List<string> { "XS", "S", "M", "L", "XL", "XXL", "3XL" };

    // Real color photos found in wwwroot/images/custom/{category-key}/ (see
    // CategoryImageResolver + CustomizeController.Custom). Each entry is
    // (ColorName, MainImagePath, Gallery) where Gallery is a list of
    // GalleryPhoto(ViewType, ImagePath) — ViewType is "front", "back",
    // "sleeve", "neck", or "extra". Falls back to a generic swatch-only
    // list with no photos if this category doesn't have any color images yet.
    var availableColors = ViewBag.AvailableColors as List<(string ColorName, string MainImagePath, List<ConceptFactory.Utils.CategoryImageResolver.GalleryPhoto> Gallery)> ?? new();
    var colors = availableColors.Any()
        ? availableColors.Select(c => c.ColorName).ToList()
        : new List<string> { "White", "Black", "Red", "Blue", "Navy", "Green", "Yellow", "Orange", "Purple", "Pink", "Gray", "Maroon" };
    var colorGalleryByName = availableColors.ToDictionary(c => c.ColorName, c => c.Gallery, StringComparer.OrdinalIgnoreCase);

    var colorMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        {"red","#e53e3e"},{"blue","#2e77b3"},{"black","#1a202c"},{"white","#ffffff"},
        {"green","#3d564a"},{"yellow","#d69e2e"},{"orange","#dd6b20"},{"purple","#805ad5"},
        {"pink","#d53f8c"},{"brown","#8f6d57"},{"gray","#57585e"},{"grey","#718096"},
        {"navy","#1a365d"},{"maroon","#742a2a"},{"teal","#2c7a7b"},{"beige","#e8dcc4"},
        {"dark gray","#44444b"},{"dark brown","#4e3d38"},{"petrol blue","#355f75"},
        {"navy blue","#3c4d8c"},{"olive green","#556b2f"},
        // Two-tone jacket colorways (Full Zip Hoodies) — split-color swatch
        // instead of a single flat hex, so the two colors are both visible
        // in the little dot rather than picking just one to represent it.
        {"black white",  "linear-gradient(135deg, #1a202c 50%, #ffffff 50%)"},
        {"onyx white",   "linear-gradient(135deg, #111318 50%, #ffffff 50%)"},
        {"blue white",   "linear-gradient(135deg, #1a365d 50%, #f5f0e6 50%)"},
        {"red green",    "linear-gradient(135deg, #742a2a 50%, #1b4332 50%)"},
        {"yellow black", "linear-gradient(135deg, #d69e2e 50%, #1a202c 50%)"},
        {"white green",  "linear-gradient(135deg, #f5f0e6 50%, #1b4332 50%)"}
    };

    var services = ViewBag.Services as List<Service> ?? new List<Service>();

    // Bags don't have a chest/sleeve/back the way apparel does — just one
    // continuous surface — so they get their own, much simpler location set.
    var categoryKey = ConceptFactory.Utils.CategoryImageResolver.GetKey(Model.CategoryName);
    var isBagCategory = categoryKey == "tote-bag";

    var printLocations = isBagCategory
        ? new[]
        {
            new { Icon = "/images/custom/tote.png", Icon2 = (string?)null, Label = "Center", Slug = "center" },
            new { Icon = "/images/custom/tote.png", Icon2 = (string?)null, Label = "Right Edges",  Slug = "right" },
            new { Icon = "/images/custom/tote.png", Icon2 = (string?)null, Label = "Full",  Slug = "full" },
            new { Icon = "/images/custom/tote.png", Icon2 = (string?)null, Label = "Left Edges",  Slug = "left" },
        }
        : new[]
        {
            new { Icon = "/images/printLoc/front.png",             Icon2 = (string?)null,                  Label = "Front",         Slug = "front" },
            new { Icon = "/images/printLoc/back.png",              Icon2 = (string?)null,                  Label = "Back",           Slug = "back" },
            new { Icon = "/images/printLoc/right.png",              Icon2 = (string?)null,                  Label = "Left Chest",     Slug = "left-chest" },
            new { Icon = "/images/printLoc/left.png",             Icon2 = (string?)null,                  Label = "Right Chest",   Slug = "right-chest" },
            new { Icon = "/images/printLoc/right-sleeve.png",       Icon2 = (string?)null,                  Label = "Left Sleeve",   Slug = "left-sleeve" },
            new { Icon = "/images/printLoc/left-sleeve.png",      Icon2 = (string?)null,                  Label = "Right Sleeve", Slug = "right-sleeve" },
            // Reuses the real Front and Back icons side by side (front left,
            // back right) instead of the old single merged icon, so it's
            // obviously "both sides" rather than one ambiguous silhouette.
            new { Icon = "/images/printLoc/front.png",             Icon2 = (string?)"/images/printLoc/back.png", Label = "Front / Back", Slug = "front-back" },
        };

    int step = 1;

    // Display name/description — based on the CATEGORY only.
    string GetItemDisplayName(string? cat)
    {
        return string.IsNullOrEmpty(cat) ? "Custom Order" : $"Custom {cat}";
    }

    string GetItemDescription(string? cat)
    {
        if (string.IsNullOrEmpty(cat))
            return "Fully customizable apparel — pick your size, color, and print location, then upload your own design.";
        var n = cat.ToLower();
        return n switch
        {
            var x when x.Contains("jacket") => "Durable, weather-ready jackets built for custom prints and embroidery — great for teams, uniforms, and cold-weather merch.",
            var x when x.Contains("hoodie") => "Soft, heavyweight hoodies perfect for bold front and back prints, cozy for everyday wear.",
            var x when x.Contains("sweater") => "Comfortable knit sweaters, great for embroidered logos or full custom print designs.",
            var x when x.Contains("tote") || x.Contains("bag") => "Sturdy canvas tote bags — an eco-friendly pick for branded giveaways and everyday carry.",
            var x when x.Contains("compression") => "Moisture-wicking compression wear built for sports teams and performance branding.",
            var x when x.Contains("spandex") => "Stretch-fit spandex tees built for movement, layering, and performance branding.",
            var x when x.Contains("waffle") => "Textured waffle-knit tees with a premium, casual feel — great for minimalist prints.",
            var x when x.Contains("cotton") => "Soft, breathable 100% cotton tees — our most popular canvas for custom prints of any size.",
            var x when x.Contains("varsity") => "Classic varsity jackets with contrast panels — a bold canvas for embroidered logos and lettering.",
            var x when x.Contains("polo") => "Classic polo shirts with a clean collar, ideal for corporate uniforms and embroidered logos.",
            var x when x.Contains("t-shirt") || x.Contains("tshirt") || x.Contains("shirt") => "Soft, breathable t-shirts — our most popular canvas for custom prints of any size.",
            _ => "Fully customizable apparel — pick your size, color, and print location, then upload your own design."
        };
    }

    string displayName = GetItemDisplayName(Model.CategoryName);
    string itemDescription = GetItemDescription(Model.CategoryName);
    string categoryThumb = ViewBag.CategoryThumb as string ?? "/images/categories/default.png";
    string syntheticId = "custom-" + (Model.CategoryID?.ToString() ?? "general");
    ViewData["Title"] = displayName;

    // Shown before the customer picks a color: the first available color's
    // full photo gallery, or just the generic category thumbnail if this
    // category has no color photos yet.
    List<ConceptFactory.Utils.CategoryImageResolver.GalleryPhoto> defaultGallery =
        (colors.Any() && colorGalleryByName.ContainsKey(colors[0]))
        ? colorGalleryByName[colors[0]]
        : new List<ConceptFactory.Utils.CategoryImageResolver.GalleryPhoto> { new("front", categoryThumb) };
}
@section Styles {
    <link rel="stylesheet" href="~/css/home/product-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/customize/customize-detail.css" asp-append-version="true" />
}

<!-- ═══ DETAIL PAGE ═══ -->
<div class="pd-page">

    <a asp-controller="Home" asp-action="hIndex" class="pd-back" onclick="return requestExitCustomize();">
        <i class="fa-solid fa-arrow-left"></i>Back to Home
    </a>

    <div class="pd-grid">

        <!-- ════ LEFT: image ════ -->
        <div class="pd-img-card">
            <div class="pd-img-main">
                <div class="pd-img-box" id="imgBox">
                    <img src="@defaultGallery[0].ImagePath" alt="@displayName" id="mainImg" data-view-type="@defaultGallery[0].ViewType"
                         class="cz-main-img"
                         onerror="if(!this.dataset.fallback){this.dataset.fallback='1'; this.src='@categoryThumb';}" />
                    <!-- Full-size mask layer: clips whatever's inside it (the design
                         overlay) to the garment's real silhouette, using that same
                         photo's own alpha-channel transparency as the mask. Kept in
                         sync with mainImg's current src by setPrintLocation-adjacent
                         JS (applyDesignMask) whenever the color or photo changes. -->
                    <div class="pd-design-mask" id="designMask"
                         style="-webkit-mask-image:url('@defaultGallery[0].ImagePath'); mask-image:url('@defaultGallery[0].ImagePath');">
                        <div class="pd-design-overlay" id="designOverlay" data-location="@printLocations[0].Slug">YOUR<br>DESIGN<br>HERE</div>
                    </div>
                </div>

                <!-- Shown INSTEAD of #imgBox only when "Front / Back" is the
                     selected print location — that option doesn't have one
                     "current side" the way Front or Back alone do, so both
                     sides are shown side by side. Each pane reuses the exact
                     same .pd-design-mask/.pd-design-overlay classes with
                     data-location="front"/"back", so the existing CSS
                     placement rules for those locations apply with zero
                     changes. See renderDualPhotos()/renderDualOverlays() in
                     customize-detail.js. -->
                <div class="pd-dual-box js-hidden" id="dualViewBox">
                    <div class="pd-dual-pane">
                        <img id="dualFrontImg" alt="Front" class="cz-main-img" />
                        <div class="pd-design-mask" id="dualFrontMask">
                            <div class="pd-design-overlay" id="dualFrontOverlay" data-location="front">FRONT<br>DESIGN<br>HERE</div>
                        </div>
                        <span class="pd-dual-label">Front</span>
                    </div>
                    <div class="pd-dual-pane">
                        <img id="dualBackImg" alt="Back" class="cz-main-img" />
                        <div class="pd-design-mask" id="dualBackMask">
                            <div class="pd-design-overlay" id="dualBackOverlay" data-location="back">BACK<br>DESIGN<br>HERE</div>
                        </div>
                        <span class="pd-dual-label">Back</span>
                    </div>
                </div>
            </div>
            <div class="pd-thumbs" id="pdThumbs">
                @* Rebuilt by JS (renderGalleryThumbs) whenever the customer picks a
                   different color — this just renders the initial (first-color) set. *@
                @for (int i = 0; i < defaultGallery.Count; i++)
                {
                    <div class="pd-thumb @(i == 0 ? "active" : "")" onclick="switchMainImage(this, '@defaultGallery[i].ImagePath', '@defaultGallery[i].ViewType')">
                        <img src="@defaultGallery[i].ImagePath" alt="@Model.CategoryName" class="cz-thumb-img" />
                    </div>
                }
            </div>
        </div>

        <!-- ════ RIGHT: info ════ -->
        <div class="pd-info">
            <div class="pd-title">
                <span>@displayName</span>
            </div>
            <div class="pd-price">Starting at ₱@Model.BasePrice.ToString("N2")</div>

            <p class="pd-desc">@itemDescription</p>

            <!-- Size -->
            @if (sizes.Any())
            {
                <div class="pd-step" id="pdSizeStep">
                    <div class="pd-step-title">1. Select Sizes</div>
                        <div class="pd-size-row">
                            @foreach (var s in sizes)
                            {
                                <div class="pd-size" onclick="selectGroup(this, '.pd-size-row', '.pd-size')">@s</div>
                            }
                        </div>
                </div>
            }

            <!-- Colors -->
            @if (colors.Any())
            {
                <div class="pd-step">
                    <div class="pd-step-title">2. Choose Color </div>
                    <div class="pd-color-row">
                        @foreach (var c in colors)
                        {
                            string hex = c.StartsWith("#") ? c : (colorMap.ContainsKey(c) ? colorMap[c] : "#cccccc");
                            <div class="pd-color" title="@c" style="--swatch:@hex"
                                 onclick="selectGroup(this, '.pd-color-row', '.pd-color'); selectCustomizeColor('@c')"></div>
                        }
                    </div>
                </div>
            }

            <!-- Printing Services -->
            @if (services.Any())
            {
                <div class="pd-step" id="pdServicesStep">
                    <div class="pd-step-title">3. Select Printing Services</div>
                        <div class="pd-svc-grid">
                            @foreach (var svc in services)
                            {
                                <div class="pd-svc" onclick="selectSvc(this)" data-name="@svc.ServiceName" data-price="@svc.ServicePrice">
                                    <div class="pd-svc-name">@svc.ServiceName</div>
                                    <div class="pd-svc-price">+₱@svc.ServicePrice.ToString("N2")</div>
                                    <div class="pd-svc-desc">@svc.ServiceDescription</div>
                                </div>
                            }
                        </div>
                </div>
            }

            <!-- Print Location -->
            <div class="pd-step" id="pdLocationStep">
                <div class="pd-step-title">4. Print Location</div>
                <div class="pd-loc-grid">
                    @foreach (var loc in printLocations)
                    {
                        <div class="pd-loc @(loc.Slug == printLocations[0].Slug ? "active" : "")"
                             onclick="selectGroup(this, '.pd-loc-grid', '.pd-loc'); setPrintLocation('@loc.Slug')">
                            @if (loc.Icon2 != null)
                            {
                                <div class="pd-loc-imgs">
                                    <img src="@loc.Icon" alt="Front" />
                                    <img src="@loc.Icon2" alt="Back" />
                                </div>
                            }
                            else
                            {
                                <img src="@loc.Icon" alt="@loc.Label" />
                            }
                            @loc.Label
                        </div>
                    }
                </div>
                <div class="pdl-specific">
                    <div class="pdl-title">Specify your print location <span class="pd-optional-label">(Optional)</span></div>
                    <p class="pd-loc-hint">Describe exactly where you want the print on the @(isBagCategory ? "bag" : "t-shirt")</p>
                    <textarea class="pd-loc-text" id="pdLocationText" rows="2"
                              placeholder="Example: Lower right side near the waist, full left side, across both sleeves, etc."></textarea>
                </div>
            </div>

            <!-- Upload Design -->
            <div class="pd-step">
                <div class="pd-step-title">5. Upload Your Design <span class="pd-optional-label">(Optional)</span></div>
                <label class="pd-upload" for="designFile">
                    <i class="fa-solid fa-cloud-arrow-up pd-upload-icon"></i>
                    <div class="pd-upload-text">
                        <strong>Click to upload your design file(s)</strong>
                        <small>PNG, JPG, or PDF — up to 5MB each. 1st photo prints on the front, 2nd on the back.</small>
                    </div>
                </label>
                <input type="file" id="designFile" accept="image/*,.pdf" multiple class="cz-hidden-input" onchange="handleFiles(this)" />
                <div class="pd-upload-previews" id="uploadPreviews"></div>
                <div class="pd-design-size-row" id="designSizeRow">
                    <label for="designSizeSlider">Design size</label>
                    <input type="range" id="designSizeSlider" min="50" max="100" value="100" step="5"
                           oninput="setDesignScale(this.value)" />
                    <span id="designSizeValue">100%</span>
                </div>
            </div>

            <!-- Quantity -->
            <div class="pd-step">
                <div class="pd-step-title">6. Quantity</div>
                <div class="pd-qty-row">
                    <div class="pd-stepper">
                        <button type="button" onclick="changeQty(-1)">&minus;</button>
                        <span id="pdQty">1</span>
                        <button type="button" onclick="changeQty(1)">+</button>
                    </div>
                </div>
            </div>

            <hr class="pd-divider" />

            <!-- Price -->
            <div class="pd-total-row">
                <span class="pd-total-label">Estimated Price</span>
                <span class="pd-total-val" id="totalPrice">₱@Model.BasePrice.ToString("N2")</span>
            </div>

            <!-- Info -->
            <div class="pd-stock">
                <i class="fa-solid fa-circle-check"></i>
                Custom-made to order
            </div>

            <hr class="pd-divider" />

            <!-- CTA -->
            <div class="pd-cta">
                <button type="button" id="pdAddToCartBtn" class="pd-btn-cart" onclick="cfDetailAddToCart()">
                    <i class="fa-solid fa-cart-plus" id="pdCartIcon"></i> <span id="pdCartLabel">Add to Cart</span>
                </button>
                <button type="button" id="pdBuyNowBtn" class="pd-btn-checkout" onclick="cfDetailBuyNow()">
                    Check Out
                </button>
            </div>

        </div>
    </div>
</div>

<!-- Exit-confirmation modal: shown when leaving Customize via "Back to Home",
     since nothing here is saved until it's added to the cart. -->
<div id="exitConfirmOverlay" class="cz-exit-overlay">
    <div class="cz-exit-modal">
        <div class="cz-exit-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <div class="cz-exit-title">Leave this customization?</div>
        <p class="cz-exit-desc">
            Your size, color, print location, and uploaded design won't be saved.
            Add it to your cart first if you want to keep it.
        </p>
        <div class="cz-exit-actions">
            <button type="button" onclick="closeExitConfirm()" class="cz-exit-btn cz-exit-btn-stay">
                Stay
            </button>
            <button type="button" onclick="confirmExitCustomize()" class="cz-exit-btn cz-exit-btn-leave">
                Leave
            </button>
        </div>
    </div>
</div>

<script>
    // Server-rendered data only — the CF_* inline-data convention used
    // across the storefront (see storefront.js). All page LOGIC lives in
    // wwwroot/js/customize/customize-detail.js instead.
    window.CF_PRODUCT = {
        id: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(syntheticId)),
        name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(displayName)),
        price: @Model.BasePrice,
        defaultImage: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(categoryThumb)),
        hasSizes: true,
        hasColors: true,
        homeUrl: '@Url.Action("hIndex", "Home")',
        cartUrl: '@Url.Action("hCart", "Home")',
        billingUrl: '@Url.Action("hBilling", "Home")'
    };
    // Each color's full photo set (main + showcase angles), read by
    // selectCustomizeColor() in customize-detail.js to rebuild the main
    // image and the thumbnail strip together when a color is clicked.
    // Each photo is { ViewType, ImagePath } — ViewType is "front", "back",
    // "sleeve", "neck", or "extra" (see Utils/CategoryImageResolver.cs).
    window.CF_COLOR_GALLERIES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(colorGalleryByName));
    // First available color, so customize-detail.js can show the right
    // photo/thumbnails before the customer has clicked a swatch.
    window.CF_CUSTOMIZE_DEFAULT_COLOR = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(colors.Any() ? colors[0] : null));
</script>
@section Scripts {
    <script src="~/js/product-details.js" asp-append-version="true"></script>
    <script src="~/js/customize/customize-detail.js" asp-append-version="true"></script>
}
