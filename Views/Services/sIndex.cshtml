@model IEnumerable<ConceptFactory.Models.Service>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    ViewData["Title"] = "Printing Services";
    ViewData["ActivePage"] = "Services";
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    int pageSize = 12;
    int startItem = totalCount == 0 ? 0 : ((page - 1) * pageSize) + 1;
    int endItem = Math.Min(page * pageSize, totalCount);
}

<div class="page-container">

    <div class="page-header">
        <div>
            <h1 class="page-title">Services Management</h1>
            <p class="page-subtitle">Manage your services, update details, and keep offerings organized.</p>
        </div>
        <div class="page-header-actions">
            <a asp-action="sDeleted" class="btn btn-outline">
                <i class="fa-solid fa-trash-can-arrow-up"></i> Archive
            </a>
            <a asp-action="sCreate" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i> Add Service
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="filter-bar">
        <form method="get" asp-action="sIndex" class="filter-form">
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" name="search" value="@ViewBag.Search"
                       placeholder="Search Services..." class="search-input" />
            </div>
            <select name="status" class="filter-select">
                <option value="">All Status</option>
                <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
                <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive</option>
            </select>
            <button type="submit" class="btn btn-outline">
                <i class="fa-solid fa-filter"></i> Filter
            </button>
        </form>
    </div>

    <!-- Table -->
    <div class="card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Service Name</th>
                    <th>Description</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Date Added</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="empty-state">
                            <i class="fa-solid fa-print"></i>
                            <p>No services found.</p>
                            <a asp-action="sCreate" class="btn btn-primary btn-sm">Add Your First Service</a>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var service in Model)
                    {
                        <tr>
                            <td>
                                <div class="service-cell">
                                    <span class="service-icon"><i class="fa-solid fa-print"></i></span>
                                    <span class="service-name">@service.ServiceName</span>
                                </div>
                            </td>
                            <td class="desc-cell">@service.ServiceDescription</td>
                            <td class="price-cell">₱@service.ServicePrice.ToString("N2")</td>
                            <td>
                                <span class="status-badge @(service.Status == "Active" ? "status-active" : "status-inactive")">
                                    @service.Status
                                </span>
                            </td>
                            <td>@service.DateAdded.ToString("MMM dd, yyyy")</td>
                            <td>
                                <div class="action-btn">
                                    <a asp-action="sEdit" asp-route-id="@service.ServiceID"
                                       class="btn-icon btn-edit" title="Edit">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <button type="button" class="btn-icon btn-delete" title="Delete"
                                            onclick="confirmDelete(@service.ServiceID, '@Html.Raw(service.ServiceName.Replace("'","\\'"))')">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        @if (totalPages > 1)
        {
            <div class="pagination">
                <span class="page-info">Showing @startItem–@endItem of @totalCount services</span>
                <div class="page-btns">
                    @if (page > 1)
                    {
                        <a asp-action="sIndex" asp-route-page="@(page-1)"
                           asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status"
                           class="page-btn">‹</a>
                    }
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <a asp-action="sIndex" asp-route-page="@i"
                           asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status"
                           class="page-btn @(i == page ? "active" : "")">@i</a>
                    }
                    @if (page < totalPages)
                    {
                        <a asp-action="sIndex" asp-route-page="@(page+1)"
                           asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status"
                           class="page-btn">›</a>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="pagination">
                <span class="page-info">Showing @startItem–@endItem of @totalCount services</span>
            </div>
        }
    </div>
</div>

<!-- Soft Delete Modal -->
<div id="deleteModal" class="modal-overlay js-modal">
    <div class="modal-box">
        <div class="modal-icon"><i class="fa-solid fa-trash"></i></div>
        <h3 class="modal-title">Delete Service?</h3>
        <p class="modal-body">
            <strong id="deleteServiceName"></strong> will be moved to deleted items.
            You can restore it later or permanently delete it from there.
        </p>
        <div class="modal-actions">
            <button onclick="closeModal()" class="btn btn-outline">Cancel</button>
            <form id="deleteForm" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Move to Deleted</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/admin/admin-live-filter.js" asp-append-version="true"></script>
<script src="~/js/admin/services-index.js" asp-append-version="true"></script>
}
