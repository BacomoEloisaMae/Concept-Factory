@model IEnumerable<ConceptFactory.Models.Service>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    ViewData["Title"] = "Deleted Services";
    ViewData["ActivePage"] = "Services";
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    int pageSize = 12;
    int startItem = totalCount == 0 ? 0 : ((page - 1) * pageSize) + 1;
    int endItem = Math.Min(page * pageSize, totalCount);
}

<div class="page-container">

    <div class="page-header">
        <div>
            <h1 class="page-title">Deleted Services</h1>
            <p class="page-subtitle">Restore items or permanently delete them from here.</p>
        </div>
        <a asp-action="sIndex" class="btn btn-outline">
            <i class="fa-solid fa-arrow-left"></i> Back to Services
        </a>
    </div>

    <div class="filter-bar">
        <form method="get" asp-action="sDeleted" class="filter-form">
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" name="search" value="@ViewBag.Search"
                       placeholder="Search deleted services..." class="search-input" />
            </div>
            <button type="submit" class="btn btn-outline">
                <i class="fa-solid fa-filter"></i> Filter
            </button>
        </form>
    </div>

    <div class="card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Service Name</th>
                    <th>Description</th>
                    <th>Price</th>
                    <th>Deleted At</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="empty-state">
                            <i class="fa-solid fa-trash-can"></i>
                            <p>No deleted services.</p>
                            <a asp-action="sIndex" class="btn btn-outline btn-sm">Back to Services</a>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var service in Model)
                    {
                        <tr style="opacity:0.75;">
                            <td>
                                <div class="service-cell">
                                    <span class="service-icon"><i class="fa-solid fa-print"></i></span>
                                    <span class="service-name">@service.ServiceName</span>
                                </div>
                            </td>
                            <td class="desc-cell">@service.ServiceDescription</td>
                            <td class="price-cell">₱@service.ServicePrice.ToString("N2")</td>
                            <td>@(service.DeletedAt?.ToString("MMM dd, yyyy") ?? "—")</td>
                            <td>
                                <div class="action-btn">
                                    <button type="button" class="btn-icon" style="color: var(--primary, #4f46e5);" title="Restore"
                                            onclick="confirmRestore(@service.ServiceID, '@Html.Raw(service.ServiceName.Replace("'", "\\'"))')">
                                        <i class="fa-solid fa-rotate-left"></i>
                                    </button>

                                    <button type="button" class="btn-icon btn-delete" title="Permanently Delete"
                                            onclick="confirmHardDelete(@service.ServiceID, '@Html.Raw(service.ServiceName.Replace("'", "\\'"))')">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        @if (totalPages > 1)
        {
            <div class="pagination">
                <span class="page-info">Showing @startItem–@endItem of @totalCount deleted services</span>
                <div class="page-btns">
                    @if (page > 1)
                    {
                        <a asp-action="sDeleted" asp-route-page="@(page - 1)"
                           asp-route-search="@ViewBag.Search" class="page-btn">‹</a>
                    }
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <a asp-action="sDeleted" asp-route-page="@i"
                           asp-route-search="@ViewBag.Search"
                           class="page-btn @(i == page ? "active" : "")">@i</a>
                    }
                    @if (page < totalPages)
                    {
                        <a asp-action="sDeleted" asp-route-page="@(page + 1)"
                           asp-route-search="@ViewBag.Search" class="page-btn">›</a>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="pagination">
                <span class="page-info">Showing @startItem–@endItem of @totalCount deleted services</span>
            </div>
        }
    </div>
</div>

<div id="restoreModal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
        <div class="modal-icon" style="color:var(--primary, #4f46e5);"><i class="fa-solid fa-arrow-rotate-left"></i></div>
        <h3 class="modal-title">Restore Service?</h3>
        <p class="modal-body">
            Are you sure you want to restore <strong id="restoreServiceName"></strong> back to the active services menu?
        </p>
        <div class="modal-actions">
            <button onclick="closeAllModals()" class="btn btn-outline">Cancel</button>
            <form id="restoreForm" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">Restore Service</button>
            </form>
        </div>
    </div>
</div>

<div id="hardDeleteModal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
        <div class="modal-icon" style="color:var(--danger,#e53e3e);"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <h3 class="modal-title">Permanently Delete Service?</h3>
        <p class="modal-body">
            <strong id="hardDeleteName"></strong> will be permanently removed and cannot be recovered.
        </p>
        <div class="modal-actions">
            <button onclick="closeAllModals()" class="btn btn-outline">Cancel</button>
            <form id="hardDeleteForm" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Delete Forever</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/admin-live-filter.js" asp-append-version="true"></script>
    <script src="~/js/admin/services-deleted.js" asp-append-version="true"></script>
}