@model ConceptFactory.Models.Product
@{
    ViewData["Title"] = Model.ProductName;
    Layout = null;

    var sizes = string.IsNullOrEmpty(Model.Size)
        ? new List<string>()
        : Model.Size.Split(',').Select(s => s.Trim()).Where(s => !string.IsNullOrEmpty(s)).ToList();

    var colors = string.IsNullOrEmpty(Model.Color)
        ? new List<string>()
        : Model.Color.Split(',').Select(s => s.Trim()).Where(s => !string.IsNullOrEmpty(s)).ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.ProductName — Concept Factory</title>
    <link rel="stylesheet" href="~/css/home-index.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>

<!-- ═══ NAVBAR ═══ -->
<nav class="navbar">
    <a asp-controller="Home" asp-action="hIndex" class="nav-brand">
        <img src="/images/logo/logo.png" alt="ConceptFactory" />
        <span class="nav-brand-name">
            Concept Factory
        </span>
    </a>
    <div class="nav-links">
        <a asp-controller="Home" asp-action="hIndex" class="nav-link active">Home</a>
        <a href="#" class="nav-link">Customize</a>
        <a href="#" class="nav-link">Track Order</a>
        <a href="#" class="nav-link">About Us</a>
    </div>
    <div class="nav-right">
        <div class="search-bar">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="Search products..." />
        </div>
        <a href="#" class="nav-icon-btn" title="Cart">
            <i class="fa-solid fa-cart-shopping"></i>
        </a>
        <div class="nav-account-wrap" id="navAccountWrap">
            <button type="button" class="btn-nav-account" onclick="toggleAccountMenu()">
                <i class="fa-regular fa-user"></i>
                My Account
                <i class="fa-solid fa-chevron-down" style="font-size:10px;"></i>
            </button>
            <div class="nav-account-menu" id="navAccountMenu">
                <a asp-controller="Products" asp-action="pIndex" class="nav-account-item admin-item">
                    <i class="fa-solid fa-gauge-high"></i> Admin Panel
                </a>
                <div class="nav-account-divider"></div>
                <a href="#" class="nav-account-item"><i class="fa-regular fa-user"></i> My Profile</a>
                <a href="#" class="nav-account-item"><i class="fa-solid fa-box"></i> My Orders</a>
                <a asp-controller="Auth" asp-action="Login" class="nav-account-item">
                    <i class="fa-solid fa-arrow-right-to-bracket"></i> Login
                </a>
            </div>
        </div>
    </div>
</nav>

<!-- ═══ DETAIL PAGE ═══ -->
<div class="detail-page">

    <!-- Back -->
    <a asp-controller="Home" asp-action="hIndex" class="detail-back">
        <i class="fa-solid fa-arrow-left"></i> Back to Products
    </a>

    <div class="detail-grid">

        <!-- LEFT: Image -->
        <div class="detail-left">
            <div class="detail-main-image">
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath" alt="@Model.ProductName" id="mainImg" />
                }
                else
                {
                    <div class="detail-placeholder">
                        <i class="fa-solid fa-shirt"></i>
                        <span>YOUR DESIGN HERE</span>
                    </div>
                }
            </div>
            <!-- Thumbnail strip (placeholders) -->
            <div class="detail-thumbs">
                @for (int i = 0; i < 4; i++)
                {
                    <div class="detail-thumb @(i == 0 ? "active" : "")">
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <img src="@Model.ImagePath" alt="thumb @i" />
                        }
                        else
                        {
                            <i class="fa-solid fa-shirt"></i>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- RIGHT: Info -->
        <div class="detail-right">
            <div class="detail-category">@(Model.Category?.CategoryName ?? "Item")</div>
            <h1 class="detail-title">@Model.ProductName</h1>

            <!-- Stars -->
            <div class="detail-stars">
                @for (int i = 0; i < 5; i++)
                {
                    <i class="fa-solid fa-star"></i>
                }
                <span class="detail-rating-text">5.0 (New)</span>
            </div>

            @* Description *@
            @if (!string.IsNullOrEmpty(Model.ProductDescription))
            {
                <p class="detail-desc">@Model.ProductDescription</p>
            }

            <!-- Upload Design -->
            <div class="detail-block">
                <span class="detail-block-label">Add Your Design</span>
                <div class="detail-upload-box" onclick="document.getElementById('designFile').click()">
                    <i class="fa-solid fa-arrow-up-from-bracket"></i>
                    <span>Click to upload or drag and drop<br><small>PNG, JPG, SVG, PDF | Max 10MB</small></span>
                </div>
                <input type="file" id="designFile" accept="image/*,.pdf,.svg" style="display:none;" onchange="showDesign(this)" />
                <div id="designFileRow" style="display:none;" class="detail-file-row">
                    <i class="fa-regular fa-file-image"></i>
                    <span id="designFileName"></span>
                    <span class="detail-file-remove" onclick="clearDesign()">Remove</span>
                </div>
            </div>

            <!-- Size -->
            @if (sizes.Any())
            {
                <div class="detail-block">
                    <span class="detail-block-label">Size</span>
                    <div class="detail-options-row">
                        @foreach (var size in sizes)
                        {
                            <button type="button" class="detail-size-chip" onclick="selectSize(this)">@size</button>
                        }
                    </div>
                </div>
            }

            <!-- Colors -->
            @if (colors.Any())
            {
                <div class="detail-block">
                    <span class="detail-block-label">Colors</span>
                    <div class="detail-options-row">
                        @foreach (var color in colors)
                        {
                            <button type="button" class="detail-color-dot" style="background:@color;"
                                    title="@color" onclick="selectColor(this)"></button>
                        }
                    </div>
                </div>
            }

            <!-- Quantity -->
            <div class="detail-block">
                <span class="detail-block-label">Quantity</span>
                <div class="detail-qty">
                    <button type="button" onclick="changeQty(-1)"><i class="fa-solid fa-minus"></i></button>
                    <span id="qtyVal">1</span>
                    <button type="button" onclick="changeQty(1)"><i class="fa-solid fa-plus"></i></button>
                </div>
            </div>

            <!-- Total -->
            <div class="detail-total">
                <span>Total Price</span>
                <span class="detail-total-price" id="totalPrice">₱@Model.Price.ToString("N2")</span>
            </div>

            <!-- Actions -->
            <div class="detail-actions">
                <button class="detail-btn-cart">
                    <i class="fa-solid fa-cart-shopping"></i> Add to Cart
                </button>
                <button class="detail-btn-buy">Buy Now</button>
            </div>

            <!-- Meta info -->
            <div class="detail-meta">
                @if (Model.StockQuantity > 0)
                {
                    <span class="detail-stock in-stock"><i class="fa-solid fa-circle-check"></i> In Stock (@Model.StockQuantity available)</span>
                }
                else
                {
                    <span class="detail-stock out-stock"><i class="fa-solid fa-circle-xmark"></i> Out of Stock</span>
                }
            </div>
        </div>
    </div>
</div>

<script>
    const unitPrice = @Model.Price;
    let qty = 1;

    function changeQty(d) {
        qty = Math.max(1, qty + d);
        document.getElementById('qtyVal').textContent = qty;
        document.getElementById('totalPrice').textContent =
            '₱' + (unitPrice * qty).toLocaleString('en-PH', { minimumFractionDigits: 2 });
    }

    function selectSize(el) {
        document.querySelectorAll('.detail-size-chip').forEach(c => c.classList.remove('active'));
        el.classList.add('active');
    }

    function selectColor(el) {
        document.querySelectorAll('.detail-color-dot').forEach(c => c.classList.remove('active'));
        el.classList.add('active');
    }

    function showDesign(input) {
        if (!input.files[0]) return;
        document.getElementById('designFileName').textContent = input.files[0].name;
        document.getElementById('designFileRow').style.display = 'flex';
    }

    function clearDesign() {
        document.getElementById('designFile').value = '';
        document.getElementById('designFileRow').style.display = 'none';
    }

    function toggleAccountMenu() {
        document.getElementById('navAccountMenu').classList.toggle('open');
    }
    document.addEventListener('click', function (e) {
        const wrap = document.getElementById('navAccountWrap');
        if (wrap && !wrap.contains(e.target))
            document.getElementById('navAccountMenu').classList.remove('open');
    });

    // Thumb switcher
    document.querySelectorAll('.detail-thumb').forEach(t => {
        t.addEventListener('click', () => {
            document.querySelectorAll('.detail-thumb').forEach(x => x.classList.remove('active'));
            t.classList.add('active');
        });
    });
</script>
</body>
</html>
