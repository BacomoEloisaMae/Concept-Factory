@model IEnumerable<ConceptFactory.Models.Product>
@{
    ViewData["Title"] = "Browse Products";
    ViewData["ActivePage"] = "Products";
    var categories = ViewBag.Categories as List<ConceptFactory.Models.Category>;
    int? selectedCategory = ViewBag.CategoryId;
}

<h1 class="store-section-title" style="font-size:24px;">Browse our Products</h1>
<p style="color:var(--store-text-sub); font-size:13.5px; margin-top:-10px; margin-bottom:22px;">
    High quality custom printed apparel for every occasion
</p>

<div class="store-filter-bar">
    <a asp-action="Browse" class="store-pill @(selectedCategory == null ? "active" : "")">All</a>
    @if (categories != null)
    {
        foreach (var cat in categories)
        {
            <a asp-action="Browse" asp-route-categoryId="@cat.CategoryID"
               class="store-pill @(selectedCategory == cat.CategoryID ? "active" : "")">
                @cat.CategoryName
            </a>
        }
    }
</div>

<div class="store-grid">
    @if (!Model.Any())
    {
        <div class="store-empty">
            <i class="fa-solid fa-box-open"></i>
            <p>No products found.</p>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <a asp-controller="Store" asp-action="Details" asp-route-id="@item.ProductID" class="store-card">
                <div class="store-card-thumb">
                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="@item.ImagePath" alt="@item.ProductName" />
                    }
                    else
                    {
                        <div class="store-card-placeholder">
                            <i class="fa-solid fa-image"></i>
                            <span>No Image</span>
                        </div>
                    }
                </div>
                <div class="store-card-body">
                    <span class="store-card-name">@item.ProductName</span>
                    <span class="store-card-price">₱@item.Price.ToString("N2")</span>
                    <span class="store-card-btn">View Product</span>
                </div>
            </a>
        }
    }
</div>
